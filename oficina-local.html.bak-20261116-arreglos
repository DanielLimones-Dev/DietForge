  // =====================================================================
  // RECAP DEL DÍA (persistente)
  // =====================================================================
  var RECAP_KEY = 'la-oficina-recap-v1';
  var day = null;

  function todayKey() {
    var d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  function loadDay() {
    var key = todayKey();
    try {
      var v = JSON.parse(localStorage.getItem(RECAP_KEY) || 'null');
      if (v && v.date === key) { day = v; return; }
    } catch (e) {}
    day = { date: key, sessions: 0, agents: [], tasksDone: 0, deploys: 0, failures: 0, incidents: 0, costAnchor: null, cost: 0 };
  }
  function saveDay() {
    try { localStorage.setItem(RECAP_KEY, JSON.stringify(day)); } catch (e) {}
  }
  function incDay(field, n) {
    if (!day) loadDay();
    day[field] = (day[field] || 0) + (n || 1);
    saveDay();
    renderRecap();
  }
  function setDay(field, val) {
    if (!day) loadDay();
    day[field] = val;
    saveDay();
  }
  function markAgentActive(agent) {
    if (!agent || agent.boss) return;
    if (!day) loadDay();
    if (day.agents.indexOf(agent.name) < 0) {
      day.agents.push(agent.name);
      saveDay();
    }
  }
  function updateDayCost() {
    if (!day) loadDay();
    if (day.costAnchor == null && realCostTotal > 0) day.costAnchor = realCostTotal;
    if (day.costAnchor != null) {
      day.cost = Math.max(0, realCostTotal - day.costAnchor);
      saveDay();
    }
  }
  function renderRecap() {
    if (!day) loadDay();
    if (!els.recapGrid) return;
    els.recapDate.textContent = day.date;
    var stats = [
      { l: 'Sesiones', v: day.sessions },
      { l: 'Agentes', v: day.agents.length },
      { l: 'Tareas completadas', v: day.tasksDone },
      { l: 'Deploys', v: day.deploys },
      { l: 'Fallos', v: day.failures },
      { l: 'Incidentes', v: day.incidents },
      { l: 'Costo del día', v: '$' + (day.cost != null ? day.cost.toFixed(2) : '0.00') }
    ];
    els.recapGrid.innerHTML = '';
    stats.forEach(function (s) {
      var el = document.createElement('div');
      el.className = 'recap-stat';
      var v = document.createElement('div');
      v.className = 'v';
      v.textContent = s.v;
      var l = document.createElement('div');
      l.className = 'l';
      l.textContent = s.l;
      el.appendChild(v);
      el.appendChild(l);
      els.recapGrid.appendChild(el);
    });
  }
  function recapLine() {
    if (!day) loadDay();
    var line = '/recap ' + day.date + ' · ' + day.sessions + ' sesiones, ' + day.agents.length + ' agentes, ' +
      day.tasksDone + ' tareas, ' + day.deploys + ' deploys, ' + day.failures + ' fallos, ' +
      day.incidents + ' incidentes, costo $' + (day.cost != null ? day.cost.toFixed(2) : '0.00');
    log(line, 'info');
    return line;
  }

