    function makeWoodTexture() {
      var c = document.createElement('canvas');
      c.width = WOOD_SIZE; c.height = WOOD_SIZE;
      var g = c.getContext('2d');
      var base = ['#b0845a', '#a87b52', '#b98e63', '#a2774f'];
      var ph = WOOD_ROW_H;
      for (var row = 0; row < WOOD_ROWS; row += 1) {
        var y0 = row * ph;
        g.fillStyle = base[row % base.length];
        g.fillRect(0, y0, WOOD_SIZE, ph);

        var shade = g.createLinearGradient(0, y0, 0, y0 + ph);
        shade.addColorStop(0, 'rgba(255,236,208,.10)');
        shade.addColorStop(0.5, 'rgba(0,0,0,0)');
        shade.addColorStop(1, 'rgba(38,22,12,.16)');
        g.fillStyle = shade;
        g.fillRect(0, y0, WOOD_SIZE, ph);

        g.fillStyle = 'rgba(48,30,17,.72)';
        g.fillRect(0, y0, WOOD_SIZE, 3);
        g.fillStyle = 'rgba(255,236,208,.10)';
        g.fillRect(0, y0 + 3, WOOD_SIZE, 1);

        var offset = (row % 2) * (WOOD_SIZE / 4);
        g.fillStyle = 'rgba(48,30,17,.55)';
        for (var x = offset; x < WOOD_SIZE; x += WOOD_SIZE / 2) g.fillRect(x, y0, 3, ph);

        for (var k = 0; k < 34; k += 1) {
          g.strokeStyle = 'rgba(58,34,17,' + (0.06 + Math.random() * 0.16).toFixed(3) + ')';
          g.lineWidth = 1 + Math.random() * 1.6;
          var yv = y0 + 6 + Math.random() * (ph - 12);
          var amp = 2 + Math.random() * 5;
          var freq = 0.008 + Math.random() * 0.012;
          var phase = Math.random() * Math.PI * 2;
          g.beginPath();
          g.moveTo(0, yv);
          for (var xx = 0; xx <= WOOD_SIZE; xx += 16) {
            g.lineTo(xx, yv + Math.sin(xx * freq + phase) * amp);
          }
          g.stroke();
        }

        if (Math.random() < 0.6) {
          var kx = 90 + Math.random() * (WOOD_SIZE - 180);
          var ky = y0 + ph * (0.3 + Math.random() * 0.4);
          var kr = 6 + Math.random() * 9;
          g.strokeStyle = 'rgba(52,30,14,.32)';
          g.lineWidth = 2;
          g.beginPath();
