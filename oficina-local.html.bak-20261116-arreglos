<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>LA OFICINA · Sala de control</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
<style>
/* ============================================================
   La Oficina · sistema visual profesional
   Paleta sobria, tipografía clara, superficies consistentes.
   Solo estilos: ninguna regla altera la lógica de la aplicación.
   ============================================================ */
:root{
  /* Paleta "Sala de control" · valores exactos de oficina-diseno-claude2.md */
  color-scheme:dark;
  --bg:#06080c;
  --bg2:#0b1018;
  --panel:#131a24;
  --panel2:#1a2330;
  --panel3:#1a2330;
  --ink:#f4f1ea;
  --ink2:#9aa7b8;
  --muted:#9aa7b8;
  --muted2:#5b6778;
  --dim:#5b6778;
  --line:#243042;
  --line2:#243042;
  --navy:#0b1018;
  --gold:#f5a524;
  --gold-soft:rgba(245,165,36,.14);
  --accent:#f5a524;
  --blue:#22d3ee;
  --orange:#f5a524;
  --red:#fb7185;
  --green:#34d399;
  --emerald:#34d399;
  --amber:#f5a524;
  --warn:#facc15;
  --accent-soft:rgba(245,165,36,.14);
  --emerald-soft:rgba(52,211,153,.13);
  --amber-soft:rgba(245,165,36,.14);
  --red-soft:rgba(251,113,133,.12);
  --sans:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,"Courier New",monospace;
  --brand:"Space Grotesk",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --r-sm:8px;
  --r:12px;
  --r-lg:16px;
  --r-pill:999px;
  --shadow-sm:0 1px 2px rgba(0,0,0,.5);
  --shadow:0 8px 32px #00000080;
  --pad:20px;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;padding:0}
body{
  background:var(--bg);
  color:var(--ink);
  font-family:var(--sans);
  font-size:16px;
  line-height:1.45;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
button{font-family:inherit}

/* ===== Cabecera ===== */
.top{
  position:sticky;top:0;z-index:40;
  display:flex;align-items:center;gap:20px;flex-wrap:wrap;
  padding:16px 28px;
  background:var(--navy);
  border-bottom:4px solid var(--gold);
}
.brand{display:flex;align-items:center;gap:14px;min-width:0}
.logo{
  width:56px;height:56px;background:var(--gold);color:var(--navy);border:none;
  font-size:15px;font-weight:800;border-radius:var(--r);
  display:grid;place-items:center;box-shadow:0 4px 14px rgba(0,0,0,.35);
}
.brand h1{
  margin:0;font-size:32px;font-weight:800;color:#ffffff;letter-spacing:-.01em;line-height:1.1;
}
.brand small{
  display:block;font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  color:#fcd34d;margin-top:4px;
}
.live{margin-left:auto;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.live-chip{
  display:inline-flex;align-items:center;gap:10px;
  padding:9px 16px;border-radius:var(--r-pill);
  background:#ffffff;border:2px solid var(--navy);
  font-size:12.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
  color:var(--ink);
}
.live-chip .dot{width:9px;height:9px;border-radius:50%;background:var(--muted2);flex:0 0 auto}
.live-chip.ok{background:var(--emerald);color:#ffffff;border-color:var(--emerald)}
.live-chip.ok .dot{background:#ffffff;animation:pulse 2s infinite}
.live-chip.off{background:var(--red);color:#ffffff;border-color:var(--red)}
.live-chip.off .dot{background:#ffffff}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.5)}50%{box-shadow:0 0 0 7px rgba(34,197,94,0)}}
.live-meta{
  font-size:13px;color:#dbe7f3;font-weight:600;font-family:var(--mono);
  max-width:520px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.clock{
  font-family:var(--mono);font-size:15px;font-weight:800;color:var(--ink);
  background:#ffffff;border:2px solid var(--navy);padding:8px 14px;
  border-radius:var(--r-pill);font-variant-numeric:tabular-nums;
}

/* ===== Escena 3D ===== */
.stage-wrap{
  position:relative;
  height:calc(100vh - 132px);
  min-height:620px;
  background:radial-gradient(ellipse at 50% 22%, #141d29 0%, #0a0f16 70%);
  border-bottom:4px solid var(--gold);
  overflow:hidden;
}
#stage{position:absolute;inset:0}
#stage canvas{display:block;width:100%;height:100%;touch-action:none;cursor:grab}
#stage canvas:active{cursor:grabbing}
.stage-fallback{
  position:absolute;inset:0;display:grid;place-items:center;padding:28px;text-align:center;
  color:#c9d6e4;font-size:16.5px;line-height:1.6;max-width:620px;margin:auto;
}
.hud-left{
  position:absolute;left:18px;top:18px;z-index:6;
  display:flex;flex-direction:column;gap:12px;max-width:calc(100% - 230px);
  pointer-events:none;
}
.hud-left > *{pointer-events:auto}
.controls{display:flex;flex-wrap:wrap;gap:8px}

/* ===== Botones ===== */
.btn{
  appearance:none;
  border:2px solid var(--navy);
  background:#ffffff;
  color:var(--navy);
  padding:0 15px;
  min-height:52px;
  border-radius:var(--r);
  font-size:16px;font-weight:700;letter-spacing:.01em;
  cursor:pointer;
  transition:background .15s,border-color .15s,color .15s,transform .1s;
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  box-shadow:var(--shadow-sm);
  white-space:nowrap;
}
.btn:hover{background:var(--navy);color:#ffffff;border-color:var(--navy)}
.btn:active{transform:translateY(1px)}
.btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.btn:disabled,.btn[disabled]{opacity:.45;cursor:not-allowed;box-shadow:none}
.btn.proj::before{
  content:"";width:9px;height:9px;border-radius:50%;background:var(--emerald);
  box-shadow:0 0 0 3px rgba(13,27,42,.10);flex:0 0 auto;
}
.btn.proj[data-project="RepForge"]::before{background:#a78bfa}
.btn.proj[data-project="DietForge"]::before{background:var(--emerald)}
.btn.proj[data-project="Suplementos"]::before{background:var(--amber)}
.btn.on{
  background:var(--emerald);border-color:var(--emerald);color:#ffffff;
  box-shadow:var(--shadow-sm);
}
.btn.mini{
  padding:8px 14px;font-size:14px;border-radius:var(--r-sm);min-height:38px;
}
.btn.approve{
  background:#15803d;color:#ffffff;border-color:#15803d;
  font-size:16px;font-weight:700;
}
.btn.approve:hover{background:#166534;border-color:#166534;color:#ffffff}
.btn.changes{
  background:#b45309;color:#ffffff;border-color:#b45309;
  font-size:16px;font-weight:700;
}
.btn.changes:hover{background:#92400e;border-color:#92400e;color:#ffffff}

/* ===== Leyenda y avisos de escena ===== */
.legend{
  display:flex;flex-wrap:wrap;gap:18px;
  background:#ffffff;
  border:2px solid var(--line2);
  border-radius:var(--r);
  padding:10px 16px;
  font-size:14px;color:var(--ink2);letter-spacing:.01em;
  width:max-content;max-width:100%;
  box-shadow:var(--shadow);
}
.legend span{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
.legend i{width:10px;height:10px;border-radius:50%;display:inline-block;flex:0 0 auto}
.meet-chip{
  position:absolute;top:70px;right:18px;z-index:6;
  display:none;align-items:center;gap:10px;
  padding:10px 16px;border-radius:var(--r-pill);
  background:#ffffff;border:2px solid var(--amber);
  color:#b45309;font-size:13.5px;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;font-family:var(--sans);
  box-shadow:var(--shadow);
}
.meet-chip.show{display:inline-flex}
.meet-chip i{width:8px;height:8px;border-radius:50%;background:var(--amber);animation:pulse 1.4s infinite}
.hint{
  position:absolute;right:18px;bottom:16px;z-index:5;
  font-size:12.5px;color:var(--ink2);letter-spacing:.01em;
  background:#ffffff;border:2px solid var(--line2);
  padding:7px 14px;border-radius:var(--r-pill);pointer-events:none;
}

/* ===== Tablero principal ===== */
.dash{
  max-width:1560px;margin:0 auto;padding:22px;
  display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);
  gap:18px;align-items:start;
}
.col{display:grid;gap:18px;min-width:0}
.panel{
  background:var(--panel);
  border:2px solid var(--line);
  border-radius:var(--r-lg);
  overflow:hidden;
  box-shadow:var(--shadow);
  min-width:0;
}
.panel-head{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:18px 22px;border-bottom:2px solid var(--line);flex-wrap:wrap;
  background:var(--panel2);
}
.panel-title{
  font-size:17px;letter-spacing:.06em;text-transform:uppercase;
  color:var(--navy);font-weight:800;
  display:flex;align-items:center;gap:10px;min-width:0;
}
.panel-title b{color:var(--navy);letter-spacing:.02em;font-size:22px;font-weight:800}
.panel-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.badge{
  font-family:var(--sans);font-size:12.5px;font-weight:700;
  background:#ffffff;border:2px solid var(--line2);
  color:var(--ink);border-radius:var(--r-pill);padding:4px 12px;
  letter-spacing:.02em;white-space:nowrap;
  font-variant-numeric:tabular-nums;
}
.badge.live-now{
  background:var(--emerald);color:#ffffff;border-color:var(--emerald);
  text-transform:uppercase;letter-spacing:.09em;font-size:11.5px;
}

/* ===== Lista de agentes ===== */
.agent-list{max-height:70vh;overflow:auto;overscroll-behavior:contain}
.office-block{border-bottom:1px solid var(--line)}
.office-block:last-child{border-bottom:none}
.office-label{
  display:flex;align-items:center;gap:9px;
  padding:12px 20px;font-size:13px;letter-spacing:.14em;text-transform:uppercase;
  font-weight:800;color:var(--navy);
  background:var(--panel2);position:sticky;top:0;z-index:2;
  border-bottom:1px solid var(--line);
}
.office-label::before{
  content:"";width:8px;height:8px;border-radius:50%;
  background:var(--oc,var(--muted));flex:0 0 auto;
}
.agent-row{
  display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:12px;
  align-items:center;padding:13px 20px;border-bottom:1px solid var(--line);
}
.agent-row:last-child{border-bottom:none}
.agent-row:hover{background:#eef3f9}
.agent-row .dot{
  width:12px;height:12px;border-radius:50%;flex:0 0 auto;
  box-shadow:0 0 0 4px rgba(13,27,42,.08);
}
.agent-row .who{min-width:0}
.agent-row .name{
  font-family:var(--sans);font-size:18px;font-weight:650;color:var(--ink);
  letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  line-height:1.25;
}
.agent-row .role{
  font-family:var(--sans);font-size:11.5px;font-weight:650;color:var(--muted);
  margin-top:2px;letter-spacing:.08em;text-transform:uppercase;
}
.agent-row .task-line{
  font-family:var(--sans);font-size:14.5px;color:var(--ink2);margin-top:4px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.35;
}
.pill{
  font-family:var(--sans);font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;
  font-weight:700;padding:5px 10px;border-radius:var(--r-pill);
  border:2px solid var(--line2);color:var(--muted2);
  background:#ffffff;white-space:nowrap;
}
.pill.working{color:var(--blue);border-color:rgba(29,78,216,.45);background:rgba(29,78,216,.10)}
.pill.review{color:var(--amber);border-color:rgba(180,83,9,.45);background:var(--amber-soft)}
.pill.changes{color:var(--red);border-color:rgba(185,28,28,.45);background:var(--red-soft)}
.pill.free{color:var(--green);border-color:rgba(21,128,61,.45);background:var(--emerald-soft)}
.live-tag{
  font-family:var(--sans);font-size:11px;letter-spacing:.1em;text-transform:uppercase;
  font-weight:700;padding:2px 8px;border-radius:var(--r-pill);
  border:1px solid var(--line2);color:var(--muted);white-space:nowrap;
}
.live-tag.on{
  color:var(--green);border-color:rgba(21,128,61,.45);background:var(--emerald-soft);
}
.agent-form{grid-column:1 / -1;display:flex;gap:10px;padding-left:24px}
.agent-form input{
  flex:1;min-width:0;background:#ffffff;border:2px solid var(--line2);
  color:var(--ink);border-radius:var(--r-sm);padding:11px 14px;font-size:15.5px;
  font-family:var(--sans);outline:none;transition:border-color .15s,box-shadow .15s;
  min-height:46px;
}
.agent-form input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(29,78,216,.16)}
.agent-form input::placeholder{color:var(--muted2)}
.agent-form input:disabled{opacity:.5;cursor:not-allowed}
.agent-form .btn{min-height:46px}
.agent-form .btn[disabled]{opacity:.4;cursor:default}

/* ===== Entregas ===== */
.delivery{
  padding:16px 20px;border-bottom:1px solid var(--line);
  display:flex;flex-direction:column;gap:10px;
}
.delivery:last-child{border-bottom:none}
.delivery-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.delivery-name{font-family:var(--sans);font-size:16.5px;font-weight:650;color:var(--ink)}
.delivery-task{font-size:15px;color:var(--ink2);line-height:1.5}
.delivery-meta{
  font-family:var(--sans);font-size:12.5px;color:var(--muted);
  letter-spacing:.01em;font-variant-numeric:tabular-nums;
}
.delivery-actions{display:flex;gap:10px;flex-wrap:wrap}
.delivery-actions .btn{min-height:46px}

/* ===== Pizarrón ===== */
.task-item{padding:13px 20px;border-bottom:1px solid var(--line)}
.task-item:last-child{border-bottom:none}
.task-head{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
.task-agent{font-family:var(--sans);font-size:14.5px;color:var(--ink);font-weight:650}
.task-pct{font-family:var(--mono);font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums}
.task-name{
  font-family:var(--sans);font-size:14px;color:var(--ink2);margin:3px 0 9px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.bar{height:6px;background:var(--panel3);border-radius:var(--r-pill);overflow:hidden;border:1px solid var(--line)}
.bar > i{display:block;height:100%;background:var(--accent);border-radius:var(--r-pill);transition:width .35s}
.empty{padding:24px 20px;text-align:center;font-size:14.5px;color:var(--muted);font-family:var(--sans)}

/* ===== Medidores de tokens (legado) ===== */
.tokens-body{padding:16px 20px;display:grid;gap:12px}
.tok-stat{display:flex;justify-content:space-between;align-items:baseline;gap:14px}
.tok-num{font-family:var(--mono);font-size:30px;font-weight:700;color:var(--ink);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.tok-sub{font-size:11px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase;font-family:var(--sans);font-weight:650}
.tok-bar{height:8px;border-radius:var(--r-pill);background:var(--panel3);border:1px solid var(--line);overflow:hidden}
.tok-bar > i{display:block;height:100%;background:var(--accent);transition:width .5s}
.tok-actions{display:flex;gap:10px;flex-wrap:wrap}
.tok-mini{display:flex;gap:18px;font-size:13px;color:var(--muted);font-family:var(--sans);flex-wrap:wrap}
.tok-mini b{color:var(--ink);font-weight:650}

/* ===== Bitácora ===== */
.log{max-height:380px;overflow:auto;padding:2px 0;overscroll-behavior:contain}
.log-item{
  display:flex;gap:12px;padding:9px 20px;font-size:14.5px;line-height:1.5;
  border-bottom:1px solid var(--line);
}
.log-item:last-child{border-bottom:none}
.log-time{
  font-family:var(--mono);font-size:11px;color:var(--muted);flex:0 0 auto;
  padding-top:3px;font-variant-numeric:tabular-nums;
}
.log-text{color:var(--ink2);min-width:0;word-break:break-word}
.log-item.review .log-text{color:var(--amber)}
.log-item.changes .log-text{color:var(--red)}
.log-item.approve .log-text{color:var(--green)}
.log-item.meet .log-text{color:#6d28d9}
.log-item.info .log-text{color:var(--blue)}

/* ===== Consola embebida ===== */
.console-panel{
  margin:0 auto 26px;max-width:1560px;border:1px solid var(--line);
  border-radius:var(--r-lg);overflow:hidden;background:var(--panel);box-shadow:var(--shadow);
}
.console-head{
  display:flex;align-items:center;gap:14px;padding:14px 20px;
  border-bottom:1px solid var(--line);flex-wrap:wrap;
}
.console-head code{
  font-family:var(--mono);font-size:12.5px;color:var(--muted);
  background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-sm);
  padding:5px 10px;
}
.console-head a{
  margin-left:auto;font-size:12px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--green);text-decoration:none;border:2px solid rgba(21,128,61,.45);
  padding:8px 16px;border-radius:var(--r-pill);font-weight:700;transition:background .15s;
}
.console-head a:hover{background:var(--emerald-soft)}
.console-panel iframe{display:block;background:var(--panel2)}
.foot{
  padding:0 20px 28px;text-align:center;font-size:12.5px;color:var(--muted);
  font-family:var(--sans);letter-spacing:.02em;
}

/* ===== Medidores reales ===== */
.meters-panel{grid-column:1 / -1}
.meters-grid{display:grid;gap:10px;padding:14px 20px}
.meter-head{
  display:grid;grid-template-columns:minmax(140px,1.1fr) repeat(3,minmax(130px,1fr));
  gap:12px;padding:0 4px;
}
.meter-head .mh{
  font-size:11px;letter-spacing:.13em;text-transform:uppercase;
  color:var(--muted);font-weight:700;
}
.meter-row{
  display:grid;grid-template-columns:minmax(140px,1.1fr) repeat(3,minmax(130px,1fr));
  gap:12px;align-items:center;padding:12px 14px;
  border:1px solid var(--line);border-radius:var(--r);background:var(--panel2);
  transition:border-color .15s,background .15s;
}
.meter-row:hover{border-color:var(--line2);background:var(--panel3)}
.meter-row .m-agent{min-width:0}
.meter-row .m-name{
  font-family:var(--sans);font-size:16.5px;font-weight:650;color:var(--ink);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.meter-row .m-model{
  font-family:var(--mono);font-size:11px;color:var(--muted);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;
}
.meter-val{
  font-family:var(--mono);font-size:16px;font-weight:650;color:var(--ink);
  white-space:nowrap;font-variant-numeric:tabular-nums;
}
.meter-val small{
  display:block;font-family:var(--sans);font-size:10px;letter-spacing:.1em;
  text-transform:uppercase;color:var(--muted);font-weight:600;margin-top:2px;
}
.meter-val.est{color:var(--muted)}
.meter-bar{
  height:7px;border-radius:var(--r-pill);background:var(--panel3);
  border:1px solid var(--line);overflow:hidden;margin-top:7px;
}
.meter-bar > i{display:block;height:100%;background:var(--accent);border-radius:var(--r-pill);transition:width .5s}
.meter-bar.amber > i{background:var(--amber)}
.meter-bar.red > i{background:var(--red)}
.meter-row .m-mem{display:flex;flex-direction:column}
.meters-more{text-align:center;padding:6px}
.meters-more button{
  background:var(--panel2);border:1px solid var(--line2);color:var(--ink2);
  font-family:var(--sans);font-size:13px;font-weight:600;
  padding:8px 16px;border-radius:var(--r-pill);cursor:pointer;transition:background .15s;
}
.meters-more button:hover{background:var(--panel3)}
.meters-empty{padding:16px 20px;font-family:var(--sans);font-size:14px;color:var(--muted)}

/* ===== Inspector ===== */
.insp-backdrop{
  position:fixed;inset:0;z-index:200;background:rgba(13,27,42,.45);
  backdrop-filter:blur(4px);display:grid;place-items:center;padding:20px;
}
.insp-card{
  width:min(560px,100%);max-height:82vh;overflow:auto;background:var(--panel);
  border:2px solid var(--line2);border-radius:var(--r-lg);
