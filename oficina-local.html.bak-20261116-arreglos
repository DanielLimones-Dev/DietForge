    function approachAngle(cur, target, k) {
      var d = ((target - cur + Math.PI * 3) % (Math.PI * 2)) - Math.PI;
      return cur + d * Math.min(1, k);
    }

    function updateAgentVisual(agent, dt, t, now) {
      if (!agent.mesh) return;
      var parts = agent.parts;
      var move = now >= agent.moveDelayUntil;
      if (move && agent.path.length) {
        var wp = agent.path[0];
        var dx = wp.x - agent.pos.x;
        var dz = wp.z - agent.pos.z;
        var dist = Math.hypot(dx, dz);
        if (dist < 0.08) {
          agent.pos.x = wp.x;
          agent.pos.z = wp.z;
          if (wp.onArrive && !wp._fired) {
            wp._fired = true;
            wp.onArrive();
          }
          if (wp.pause && !agent.pausing) {
            agent.pausing = true;
            agent.pauseUntil = now + wp.pause;
            if (wp.face !== undefined) agent.facing = wp.face;
          }
          if (!wp.pause || now >= agent.pauseUntil) {
            agent.path.shift();
            agent.pausing = false;
            agent.pauseUntil = 0;
            if (!agent.path.length) agent.walking = false;
          } else {
            agent.walking = false;
          }
        } else {
          agent.pausing = false;
          var speed = agent.boss ? 2.33 : 2.7;
          var step = Math.min(dist, speed * dt);
          agent.pos.x += dx / dist * step;
          agent.pos.z += dz / dist * step;
          agent.heading = Math.atan2(dx, dz);
          agent.walking = true;
        }
      } else {
        agent.walking = false;
      }

      if (meeting.active && agent.path.length === 0 && !agent.seated && !agent.celebrate) {
        var dd = Math.hypot(agent.pos.x - agent.seatX, agent.pos.z - agent.seatZ);
        if (isFinite(dd) && dd < 0.5) agent.seated = true;
      }

      if (!meeting.active && agent.realIntent === 'free' && agent.path.length === 0 && !agent.seated && !agent.celebrate) {
        var dh = Math.hypot(agent.pos.x - agent.home.x, agent.pos.z - agent.home.z);
        if (isFinite(dh) && dh < 0.5) agent.seated = true;
      }

      var rotTarget = agent.walking ? agent.heading : (agent.seated ? agent.facing : agent.facing);
      agent.rot = approachAngle(agent.rot, rotTarget, dt * 7);
      agent.mesh.rotation.y = agent.rot;
      agent.mesh.position.x = agent.pos.x;
      agent.mesh.position.z = agent.pos.z;

      var tm = t + agent.phase;
      var y = 0;
      var legSwing = 0;
      var armX = 0;
      var armZ = 0.1;
      var headY = 0;
      var headX = 0;

      if (agent.celebrate) {
        y = Math.abs(Math.sin(tm * 6.5)) * 0.5;
        armZ = 2.25;
        armX = -0.2;
        legSwing = Math.sin(tm * 9) * 0.25;
        headX = -0.15;
      } else if (agent.seated) {
        y = -0.12;
        legSwing = 0;
        parts.legs[0].rotation.x = -1.32;
        parts.legs[1].rotation.x = -1.32;
        armX = -0.92;
        armZ = 0.22;
        headY = Math.sin(tm * 0.5) * 0.16;
      } else if (agent.walking) {
        legSwing = Math.sin(tm * 9.5) * 0.7;
        armX = -Math.sin(tm * 9.5) * 0.55;
        armZ = 0.12;
        y = Math.abs(Math.sin(tm * 9.5)) * 0.035;
      } else if (agent.state === 'working' || agent.state === 'changes') {
        armX = -1.16 + Math.sin(tm * 15) * 0.2;
        armZ = 0.16;
        legSwing = 0;
        y = Math.sin(tm * 15) * 0.012;
        headX = 0.06 + Math.sin(tm * 7.5) * 0.025;
      } else if (agent.state === 'review') {
        armX = 0.04 + Math.sin(tm * 1.4) * 0.06;
        armZ = 0.12;
        headY = Math.sin(tm * 0.7) * 0.22;
        y = Math.sin(tm * 1.5) * 0.012;
      } else {
        armX = 0.02;
        armZ = 0.09;
        headY = Math.sin(tm * 0.55) * 0.3;
        y = Math.sin(tm * 1.35) * 0.014;
      }

      if (!agent.seated) {
        parts.legs[0].rotation.x = legSwing;
        parts.legs[1].rotation.x = -legSwing;
      }
      parts.arms[0].rotation.x = armX + (agent.walking ? 0 : Math.sin(tm * 2) * 0.01);
      parts.arms[1].rotation.x = armX - (agent.walking ? 0 : Math.sin(tm * 2) * 0.01);
      parts.arms[0].rotation.z = -armZ;
      parts.arms[1].rotation.z = armZ;
      if (agent.raisedHand) {
        parts.arms[1].rotation.x = -0.55 + Math.sin(tm * 6) * 0.1;
        parts.arms[1].rotation.z = 2.55;
      }
      parts.head.rotation.y = headY;
      parts.head.rotation.x = headX;
      agent.mesh.position.y = y;
    }

    function animate() {
      requestAnimationFrame(animate);
      var now = performance.now();
      var dt = Math.min(0.05, (now - lastMs) / 1000);
      lastMs = now;
      var t = clock.getElapsedTime();

      crew.forEach(function (a) {
        if (meeting.active) {
          if (!a.seatX && a.seatX !== 0) {
            var seat = SEATS[a.index % SEATS.length];
            a.seatX = seat.x;
            a.seatZ = seat.z;
          }
        } else if (a.seatX !== undefined) {
          a.seatX = undefined;
          a.seatZ = undefined;
          a.seated = false;
        }
        updateAgentVisual(a, dt, t, now);
      });

      if (confetti && confetti.visible) {
        confettiLife -= dt;
        var posAttr = confettiGeo.attributes.position;
        for (var i = 0; i < confettiCount; i += 1) {
          var v = confettiVel[i];
          v.y -= 3.4 * dt;
          posAttr.array[i * 3] += v.x * dt;
          posAttr.array[i * 3 + 1] += v.y * dt;
          posAttr.array[i * 3 + 2] += v.z * dt;
          if (posAttr.array[i * 3 + 1] < 0.06) {
            posAttr.array[i * 3 + 1] = 0.06;
            v.y = 0;
            v.x *= 0.9;
            v.z *= 0.9;
          }
        }
        posAttr.needsUpdate = true;
        if (confettiLife <= 0) confetti.visible = false;
      }

      if (beaconGroup.visible) {
        beaconGroup.rotation.y += dt * 2.2;
        beaconBulb.material.opacity = 0.7 + Math.sin(t * 6) * 0.3;
      }

      renderer.render(scene, camera);
    }

    animate();
  }

  // =====================================================================
  // CAPA DE DATOS OPENCODE (real) — API 2.x: /api/session y /api/session/{id}/message
  // =====================================================================
  var OP_BASE = 'http://localhost:4096/api';
  var ocSessions = [];
  var sessionCache = {};
  var ocConnected = false;
  var ocFetching = false;
  var agentMetrics = {};
  var realCostTotal = 0;
  var realTokenEvents = [];
  var seenSessionIds = {};
  var seenToolErrors = {};
  var warnedMemory = {};
  var sessionTotals = {};
  var anyRealActive = false;

  function normStr(s) { return (s || '').toLowerCase().replace(/[^a-z0-9]/g, ''); }

  function findAgent(name) {
    var n = normStr(name);
    for (var i = 0; i < crew.length; i += 1) {
      if (normStr(crew[i].name) === n) return crew[i];
    }
    return null;
  }

  function modelWindow(modelId) {
    var m = normStr(modelId || '');
    if (/deepseek/.test(m)) return { w: 64000, est: false };
    if (/gpt|openai|chatgpt|o1|o3|o4/.test(m)) return { w: 128000, est: false };
    if (/gemini/.test(m)) return { w: 1000000, est: false };
    if (/claude|anthropic/.test(m)) return { w: 200000, est: false };
    return { w: 200000, est: true };
  }

  function matchSessionAgent(session) {
    var agentField = session.agent || '';
    var modelId = (session.model && session.model.id) || '';
    var providerId = (session.model && session.model.providerID) || '';
    var title = session.title || '';
    var hay = normStr(agentField + ' ' + modelId + ' ' + providerId + ' ' + title);
    if (/claude|anthropic/.test(hay)) return findAgent('Claude');
    if (/deepseek/.test(hay)) return findAgent('DeepSeek');
    if (/gpt|openai|chatgpt/.test(hay)) return findAgent('GPT');
    if (/gemini|google/.test(hay)) return findAgent('Gemini');
    var nA = normStr(agentField);
    for (var i = 0; i < crew.length; i += 1) {
      var a = crew[i];
      if (a.boss) continue;
      if (a.name === 'Mini lemons' || a.name === 'Claude' || a.name === 'DeepSeek' || a.name === 'GPT' || a.name === 'Gemini') continue;
      var nn = normStr(a.name);
      if (nn && (nA.indexOf(nn) >= 0 || nn.indexOf(nA) >= 0 || hay.indexOf(nn) >= 0)) return a;
    }
    return null;
  }

  // =====================================================================
  // ESTADO REAL DE PERSONAJES — sesiones OpenCode → movimiento 3D
  // =====================================================================
  var PRIMARY_AGENTS = { build: true, plan: true };

  function chalaneByModel(session) {
    var modelId = (session.model && session.model.id) || '';
    var providerId = (session.model && session.model.providerID) || '';
    var hay = normStr(providerId + ' ' + modelId);
    if (/deepseek/.test(hay)) return findAgent('DeepSeek');
    if (/openai|gpt|chatgpt/.test(hay)) return findAgent('GPT');
    if (/anthropic|claude/.test(hay)) return findAgent('Claude');
    if (/google|gemini/.test(hay)) return findAgent('Gemini');
    return findAgent('Mini lemons');
  }

  function mapSessionToAgent(session) {
    var agentField = (session.agent || '').trim();
    var nA = normStr(agentField);
    if (!nA || PRIMARY_AGENTS[agentField.toLowerCase()]) {
      return chalaneByModel(session);
    }
    var a = findAgent(agentField);
    if (!a || a.boss) return null;
    if (a.name === 'Mini lemons' || a.name === 'Claude' || a.name === 'DeepSeek' || a.name === 'GPT' || a.name === 'Gemini') return null;
    return a;
  }

  function normOpTokens(tokens) {
    if (!tokens || typeof tokens !== 'object') return 0;
    if (typeof tokens.total === 'number') return tokens.total;
    return (tokens.input || 0) + (tokens.output || 0) + (tokens.reasoning || 0);
  }

  function computeSessionTotals(entry) {
    var cost = 0, tokens = 0;
    ((entry && entry.messages) || []).forEach(function (m) {
      if (!m) return;
      var info = m.info || m;
      var c = null;
      if (typeof info.cost === 'number') c = info.cost;
      else if (typeof m.cost === 'number') c = m.cost;
      if (c !== null) cost += c;
      tokens += normOpTokens(info.tokens || m.tokens);
    });
    return { cost: cost, tokens: tokens };
  }

  function isSessionActive(session, entry) {
    var now = Date.now();
    var updated = (session.time && (session.time.updated || session.time.created)) || 0;
    if (updated && (now - updated < 3 * 60 * 1000)) return true;

    var cur = computeSessionTotals(entry);
    var prev = sessionTotals[session.id];
    sessionTotals[session.id] = cur;
    if (prev && (prev.cost !== cur.cost || prev.tokens !== cur.tokens)) return true;

    var msgs = (entry && entry.messages) || [];
    if (msgs.length) {
      var last = msgs[msgs.length - 1];
      var linfo = (last && last.info) || last;
      var lrole = (linfo && linfo.role) || (last && last.type) || '';
      if (lrole === 'assistant') {
        if (last && Array.isArray(last.content)) {
          // API 2.x: el cierre viene como `finish` en el mensaje y `content[]` en bloques.
          if (!last.finish) return true;
        } else {
          var parts = (last && last.parts) || [];
          var hasFinish = parts.some(function (p) { return p && p.type === 'step-finish'; });
          if (!hasFinish) return true;
        }
      }
    }
    return false;
  }

  function realState(session, entry) {
    return isSessionActive(session, entry) ? 'working' : 'ended';
  }

  function dist2(a, b) {
    var dx = a.x - b.x, dz = a.z - b.z;
    return Math.sqrt(dx * dx + dz * dz);
  }

  function setAgentWorking(a, session) {
    a.realIntent = 'working';
    a.seated = false;
    lowerHand(a);
    var title = (session && session.title) || '';
    if (a.state !== 'working' || a.dueAt || (title && a.task !== title)) {
      a.state = 'working';
      a.dueAt = 0;
      if (title) a.task = title;
      setStateVisual(a);
    }
    if (!a.path.length && dist2(a.pos, a.home) > 0.5) {
      goTo(a, deskPath(a), 0);
    }
  }

  function setAgentIdle(a) {
    var d = deliveries.filter(function (x) { return x.agentId === a.id; })[0];
    if (d && d.status === 'review') {
      a.realIntent = 'review';
      if (a.state !== 'review') {
        a.state = 'review';
        a.task = d.task || a.task || '';
        setStateVisual(a);
        requeue();
      }
      raiseHand(a);
      return;
    }
    if (d && d.status === 'changes') {
      a.realIntent = 'changes';
      a.seated = false;
      if (a.state !== 'changes') {
        a.state = 'changes';
        a.task = d.task || a.task || '';
        a.dueAt = 0;
        setStateVisual(a);
      }
      lowerHand(a);
      if (!a.path.length && dist2(a.pos, a.home) > 0.5) {
        goTo(a, deskPath(a), 0);
      }
      return;
    }
    a.realIntent = 'free';
    lowerHand(a);
    if (a.state !== 'free') {
      a.state = 'free';
      a.task = '';
      a.dueAt = 0;
      setStateVisual(a);
    }
    if (!a.path.length) {
      if (dist2(a.pos, a.home) > 0.5) {
        goTo(a, deskPath(a), 0);
      } else if (!a.seated) {
        a.seated = true;
      }
    }
  }

  function syncRealStates() {
    var realMap = {};
    ocSessions.forEach(function (s) {
      var agent = mapSessionToAgent(s);
      if (!agent) return;
      var entry = sessionCache[s.id];
      var active = realState(s, entry) === 'working';
      var cur = realMap[agent.id];
      if (!cur || (active && !cur.active)) {
        realMap[agent.id] = { session: s, active: active, entry: entry };
      }
    });

    anyRealActive = false;
    Object.keys(realMap).forEach(function (k) {
      if (realMap[k].active) anyRealActive = true;
    });

    crew.forEach(function (a) {
      if (a.boss) {
        a.hasRealSession = false;
        a.live = false;
        return;
      }
      var r = realMap[a.id];
      a.hasRealSession = !!r;
      a.live = !!(r && r.active);
      if (!r) {
        a.realIntent = null;
        if (a.liveEl) {
          a.liveEl.textContent = 'demo';
          a.liveEl.className = 'live-tag';
        }
        return;
      }
      if (meeting.active) return;
      if (r.active) setAgentWorking(a, r.session);
      else setAgentIdle(a);
      if (a.liveEl) {
        a.liveEl.textContent = a.live ? 'EN VIVO' : 'demo';
        a.liveEl.className = 'live-tag' + (a.live ? ' on' : '');
      }
      if (a.bubble) drawBubble(a);
    });
  }

  // ---------------------------------------------------------------------
  // Transporte API 2.x: credentials include (reusa la Basic Auth del navegador),
  // lista y mensajes tolerantes a array plano o {data:[...]}, y detección de
  // HTML/401 para caer a modo demo sin romper la página.
  // ---------------------------------------------------------------------
  async function opFetchJson(path, timeoutMs) {
    var c = new AbortController();
    var t = setTimeout(function () { c.abort(); }, timeoutMs || 4000);
    try {
      var res = await fetch(OP_BASE + path, {
        cache: 'no-store',
        credentials: 'include',
        signal: c.signal
      });
      clearTimeout(t);
      if (!res || !res.ok) return { ok: false, reason: 'status' };
      var ctype = '';
      try { ctype = (res.headers.get('content-type') || '').toLowerCase(); } catch (e) { ctype = ''; }
      if (ctype.indexOf('html') >= 0) return { ok: false, reason: 'html' };
      var text = await res.text();
      if (!text) return { ok: true, data: null };
      if (text.replace(/^\s+/, '').charAt(0) === '<') return { ok: false, reason: 'html' };
      try { return { ok: true, data: JSON.parse(text) }; }
      catch (e2) { return { ok: false, reason: 'json' }; }
    } catch (err) {
      clearTimeout(t);
      return { ok: false, reason: 'network' };
    }
  }

  function opList(data) {
    if (Array.isArray(data)) return data;
    if (data && Array.isArray(data.data)) return data.data;
    return [];
  }

  function normOpMessage(raw) {
    if (!raw || typeof raw !== 'object') return null;
    // Formato nuevo 2.x: { type, agent, model, content[], cost, tokens, finish }
    if (Array.isArray(raw.content)) {
      var role = raw.type || raw.role || 'assistant';
      var parts = [];
      var textAll = '';
      raw.content.forEach(function (c) {
        if (!c || typeof c !== 'object') return;
        if (c.type === 'text') {
          var tx = (typeof c.text === 'string') ? c.text : '';
          textAll += tx;
          parts.push({ type: 'text', text: tx });
        } else if (c.type === 'tool') {
          var st = c.state || {};
          var failed = st.status === 'error' || !!c.error;
          parts.push({
            type: 'tool',
            id: c.id || c.callID,
            callID: c.callID || c.id,
            tool: c.tool || c.name || c.toolName || 'tool',
            state: {
              status: failed ? 'error' : (st.status || 'completed'),
              error: st.error || c.error
            }
          });
        } else if (c.type) {
          parts.push({ type: c.type });
        }
      });
      if (raw.finish) parts.push({ type: 'step-finish' });
      var created = (raw.time && (raw.time.created || raw.time.updated)) || raw.created || 0;
      var completed = raw.finish ? ((raw.time && (raw.time.completed || raw.time.updated)) || created) : 0;
      return {
        info: {
          role: role,
          cost: (typeof raw.cost === 'number') ? raw.cost : null,
          tokens: raw.tokens || null,
          modelID: (raw.model && (raw.model.id || raw.model.modelID)) || raw.modelID || '',
          agent: raw.agent || '',
          text: textAll,
          time: { created: created, completed: completed || 0 }
        },
        parts: parts,
        content: raw.content,
        finish: raw.finish || null
      };
    }
    // Formato viejo { info:{...}, parts:[...] } se conserva intacto.
    return raw;
  }

  async function fetchSessionMessages(session) {
    var r = await opFetchJson('/session/' + session.id + '/message', 4000);
    if (!r.ok) { sessionCache[session.id] = { messages: null, fetchedAt: Date.now() }; return; }
    var list = opList(r.data);
    var msgs = [];
    for (var i = 0; i < list.length; i += 1) {
      var n = normOpMessage(list[i]);
      if (n) msgs.push(n);
    }
    sessionCache[session.id] = { messages: msgs, fetchedAt: Date.now() };
  }

  async function refreshOpenCode() {
    if (ocFetching) return;
    ocFetching = true;
    try {
      var r = await opFetchJson('/session', 4000);
      if (r.ok) {
        ocSessions = opList(r.data);
        ocConnected = true;
      } else {
        ocConnected = false;
        // HTML de una web o 401/403: no hay API utilizable → modo demo.
        if (r.reason === 'status' || r.reason === 'html' || r.reason === 'json') ocSessions = [];
      }
    } catch (e) {
      ocConnected = false;
    }
    if (ocSessions.length) {
      var nowMs = Date.now();
      var targets = ocSessions.filter(function (s) {
        if (!sessionCache[s.id]) return true;
        var t = (s.time && (s.time.updated || s.time.created)) || 0;
        return !t || (nowMs - t < 5 * 60 * 1000);
      }).slice(0, 8);
      for (var i = 0; i < targets.length; i += 1) {
        await fetchSessionMessages(targets[i]);
      }
    }
    ocFetching = false;
    computeMetrics();
    renderMeters();
    renderRecap();
    syncRealStates();
  }

  function computeMetrics() {
    agentMetrics = {};
    realCostTotal = 0;
    realTokenEvents = [];
    var todayStart = new Date();
    todayStart.setHours(0, 0, 0, 0);
    var daySessions = 0;
    ocSessions.forEach(function (s) {
      if (s.time && s.time.created && s.time.created >= todayStart.getTime()) daySessions += 1;
      seenSessionIds[s.id] = true;
    });
    setDay('sessions', daySessions);

    Object.keys(sessionCache).forEach(function (sid) {
      var entry = sessionCache[sid];
      if (!entry || !entry.messages) return;
      var sess = null;
      for (var si = 0; si < ocSessions.length; si += 1) {
        if (ocSessions[si].id === sid) { sess = ocSessions[si]; break; }
      }
      var agent = sess ? matchSessionAgent(sess) : null;
      entry.messages.forEach(function (m) {
        var info = m.info || m;
        var role = info.role;
        var modelId = info.modelID || (info.model && info.model.id) || (sess && sess.model && sess.model.id) || '';
        var tokens = null;
        if (info.tokens) {
          if (typeof info.tokens.total === 'number') tokens = info.tokens.total;
          else tokens = (info.tokens.input || 0) + (info.tokens.output || 0) + (info.tokens.reasoning || 0);
        }
        var cost = (typeof info.cost === 'number') ? info.cost : null;
        var completed = info.time && (info.time.completed || info.time.created);
        if (role === 'assistant') {
          if (cost != null) realCostTotal += cost;
          if (tokens != null && completed) realTokenEvents.push({ t: completed, n: tokens });
        }
        if (!agent) return;
        var key = agent.id;
        if (!agentMetrics[key]) {
          agentMetrics[key] = { cost: 0, hasCost: false, tokens: 0, hasTokens: false, model: '', tools: {}, toolsList: [], tokenEvents: [], lastError: null, transcript: '', lastUser: '', task: '' };
        }
        var am = agentMetrics[key];
        if (cost != null) { am.cost += cost; am.hasCost = true; }
        if (tokens != null) { am.tokens += tokens; am.hasTokens = true; if (completed) am.tokenEvents.push({ t: completed, n: tokens }); }
        if (modelId) am.model = modelId;
        if (role === 'user' && info.text) am.lastUser = info.text;
        if (sess && sess.title) am.task = sess.title;
        if (agent) markAgentActive(agent);
        var parts = m.parts || [];
        parts.forEach(function (p) {
          if (p.type === 'tool') {
            if (!am.tools[p.tool]) am.tools[p.tool] = { name: p.tool, failed: false };
            if (p.state && p.state.status === 'error') {
              am.tools[p.tool].failed = true;
              am.lastError = { tool: p.tool, error: p.state.error || 'error' };
              if (completed && (Date.now() - completed < 5 * 60 * 1000)) {
                var ek = p.id || (p.callID + '|' + p.tool);
                if (!seenToolErrors[ek]) {
                  seenToolErrors[ek] = true;
                  recordFailure(agent, p.tool, completed);
                }
              }
            }
          } else if (p.type === 'text') {
            am.transcript = p.text;
          }
        });
      });
    });

    Object.keys(agentMetrics).forEach(function (k) {
      var am = agentMetrics[k];
      am.toolsList = Object.keys(am.tools).map(function (n) { return am.tools[n]; });
      am.transcript = (am.transcript || am.lastUser || '').slice(-320);
      var cutoff = Date.now() - 10 * 60 * 1000;
      am.tokenEvents = am.tokenEvents.filter(function (e) { return e.t >= cutoff; });
    });

    realTokenEvents.sort(function (a, b) { return a.t - b.t; });
    var rcut = Date.now() - 10 * 60 * 1000;
    realTokenEvents = realTokenEvents.filter(function (e) { return e.t >= rcut; });
    updateDayCost();
  }

  // =====================================================================
  // MEDIDORES REALES (Nómina / Electricidad / Memoria)
  // =====================================================================
  var metersExpanded = false;

  function tokensPerMin(am) {
    var evs = am.tokenEvents || [];
    var cutoff = Date.now() - 5 * 60 * 1000;
    var sum = 0;
    for (var i = 0; i < evs.length; i += 1) {
      if (evs[i].t >= cutoff) sum += evs[i].n;
    }
    return Math.round(sum / 5);
  }

  function meterRow(a) {
    var metrics = agentMetrics || {};
    var am = metrics[a.id];
    var row = document.createElement('div');
    row.className = 'meter-row';
    row.style.cursor = 'pointer';
    row.addEventListener('click', function () { openInspector(a); });

    var who = document.createElement('div');
    who.className = 'm-agent';
    var nm = document.createElement('div');
    nm.className = 'm-name';
    nm.textContent = a.name;
    var md = document.createElement('div');
    md.className = 'm-model';
    md.textContent = (am && am.model) ? am.model : 'sin modelo';
    who.appendChild(nm);
    who.appendChild(md);
    row.appendChild(who);

    var nom = document.createElement('div');
    if (am && am.hasCost) {
      nom.innerHTML = '<div class="meter-val"><b class="m-num">$' + am.cost.toFixed(2) + '</b></div><small>costo acumulado</small>';
    } else {
      nom.innerHTML = '<div class="meter-val est"><b class="m-num">est.</b></div><small>sin costo en mensajes</small>';
    }
    row.appendChild(nom);

    var elec = document.createElement('div');
    var tokMin = am ? tokensPerMin(am) : 0;
    elec.innerHTML = '<div class="meter-val"><b class="m-num">' + fmt(tokMin) + '</b><span class="m-unit">tok/min</span></div><small>últimos 5 min</small>';
    row.appendChild(elec);

    var mem = document.createElement('div');
    mem.className = 'm-mem';
    var win = (am && am.model) ? modelWindow(am.model) : { w: 200000, est: true };
    var pct = (am && am.hasTokens) ? clamp(am.tokens / win.w * 100, 0, 100) : 0;
    var barCls = pct >= 90 ? 'meter-bar red' : (pct >= 70 ? 'meter-bar amber' : 'meter-bar');
    var valTxt = (am && am.hasTokens) ? fmt(am.tokens) + ' tok' : '—';
    mem.innerHTML =
      '<div class="meter-val"><b class="m-num">' + Math.round(pct) + '%</b>' + (win.est ? '<span class="m-unit">est.</span>' : '') + '</div>' +
      '<small>' + valTxt + ' / ' + fmt(win.w) + '</small>' +
      '<div class="' + barCls + '"><i style="width:' + pct.toFixed(1) + '%"></i></div>';
    row.appendChild(mem);

    if (am && am.hasTokens && pct >= 85 && !warnedMemory[a.id]) {
      warnedMemory[a.id] = true;
      log('El escritorio de ' + a.name + ' se está llenando', 'review');
    }
    return row;
  }

  function renderMeters() {
    if (!els.metersGrid) return;
    var metrics = agentMetrics || {};
    var activeAgents = crew.filter(function (a) {
      if (a.boss || a.name === 'Mini lemons') return false;
      return !!metrics[a.id] || a.state !== 'free';
    });
    activeAgents.sort(function (a, b) {
      return (metrics[b.id] ? 1 : 0) - (metrics[a.id] ? 1 : 0);
    });

    if (ocConnected) els.meterStatus.textContent = 'OpenCode conectado';
    else if (activeAgents.length) els.meterStatus.textContent = activeAgents.length + ' activos · OpenCode caído';
    else els.meterStatus.textContent = 'sin datos de OpenCode';

    els.metersGrid.innerHTML = '';
    if (!activeAgents.length) {
      var e0 = document.createElement('div');
      e0.className = 'meters-empty';
      e0.textContent = 'Sin agentes activos. Encarga trabajo o activa el modo demo.';
      els.metersGrid.appendChild(e0);
      return;
    }
    var head = document.createElement('div');
    head.className = 'meter-head';
    head.innerHTML = '<span class="mh">Agente</span><span class="mh">Nómina</span><span class="mh">Electricidad</span><span class="mh">Memoria</span>';
    els.metersGrid.appendChild(head);

    var collapsed = activeAgents.length > 4;
    var shown = (collapsed && !metersExpanded) ? activeAgents.slice(0, 4) : activeAgents;
    shown.forEach(function (a) { els.metersGrid.appendChild(meterRow(a)); });

    if (collapsed) {
      var more = document.createElement('div');
      more.className = 'meters-more';
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = metersExpanded ? 'Colapsar' : ('Mostrar ' + (activeAgents.length - 4) + ' más');
      btn.addEventListener('click', function () {
        metersExpanded = !metersExpanded;
        renderMeters();
      });
      more.appendChild(btn);
      els.metersGrid.appendChild(more);
    }
  }

  // =====================================================================
  // INSPECTOR
  // =====================================================================
  function closeInspector() {
    els.inspBackdrop.hidden = true;
  }

  function openInspector(agent) {
    var am = agentMetrics[agent.id];
    var hasReal = !!am;
    els.inspCard.innerHTML = '';

    var head = document.createElement('div');
    head.className = 'insp-head';
    var dot = document.createElement('span');
    dot.className = 'dot';
    dot.style.background = (STATUS[agent.state] || STATUS.free).color;
    var tt = document.createElement('div');
    tt.className = 't';
    tt.textContent = agent.name;
    var rl = document.createElement('div');
    rl.className = 'role';
    rl.textContent = agent.role || (agent.boss ? 'Patrón' : '');
    var xx = document.createElement('button');
    xx.type = 'button';
    xx.className = 'x';
    xx.textContent = '×';
    xx.setAttribute('aria-label', 'Cerrar');
    xx.addEventListener('click', closeInspector);
    head.appendChild(dot);
    head.appendChild(tt);
    head.appendChild(rl);
    head.appendChild(xx);
    els.inspCard.appendChild(head);

    var body = document.createElement('div');
    body.className = 'insp-body';

