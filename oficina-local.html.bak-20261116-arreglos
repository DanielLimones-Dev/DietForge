  function approveDelivery(id) {
    var d = deliveries.find(function (x) { return x.id === id; });
    if (!d) return;
    var agent = crew[d.agentId];
    deliveries = deliveries.filter(function (x) { return x.id !== id; });
    agent.state = 'free';
    agent.task = '';
    agent.deliveryId = null;
    agent.round = 0;
    agent.celebrate = false;
    var spot = nextLounge();
    goTo(agent, loungePath(agent, spot), 0);
    setStateVisual(agent);
    log(agent.name + ' · entrega aprobada. Pasa a descansar.', 'approve');
    chatAdd(crew[0], 'Aprobé la entrega de ' + agent.name + ': ' + d.task, { toName: agent.name });
    charge(180);
    lowerHand(agent);
    closePermission(d.id);
    recordDone(agent, d.task);
    if (agent.name === 'deploy') recordDeploySuccess();
    requeue();
    renderDeliveries();
    renderTasks();
