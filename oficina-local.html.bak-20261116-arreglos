  var boardBacklog = [
    'Auditar endpoints sin auth', 'Revisar RLS de clientes', 'Optimizar consulta de macros',
    'Migrar esquema de rutinas', 'Escribir test de regresión', 'Refactor del SaveQueue'
  ];
  var boardDone = [];

  function boardData() {
    var todo = boardBacklog.map(function (t) {
      return { task: t, agent: '', blocked: false };
    });
    var blocked = crew.filter(function (a) {
      return !a.boss && a.task && a.state === 'changes';
    }).map(function (a) {
      return { task: a.task, agent: a.name, blocked: true };
    });
    var inProgress = crew.filter(function (a) {
      return !a.boss && a.task && a.state === 'working';
    }).map(function (a) {
      return { task: a.task, agent: a.name, blocked: false };
    });
    var review = deliveries.filter(function (d) { return d.status === 'review'; }).map(function (d) {
      var a = crew[d.agentId];
      return { task: d.task, agent: a.name, blocked: false, reviewing: true };
    });
    var done = boardDone.slice(-12).map(function (d) {
      return { task: d.task, agent: d.agent, blocked: false, done: true };
    });
    return { todo: todo.concat(blocked), inProgress: inProgress.concat(review), done: done };
  }

