  function launchProject(name) {
    if (meeting.active) {
      log('Ya hay una reunión en curso en la sala de juntas.', 'info');
      return;
    }
    meeting.active = true;
    meeting.phase = 'gather';
    meeting.startedAt = performance.now();
    meeting.until = meeting.startedAt + 3400;
    meeting.project = name;
    els.meetChip.classList.add('show');
    els.meetText.textContent = 'REUNIÓN · ' + name.toUpperCase() + ' · CONVOCANDO';
    els.endMeetBtn.hidden = false;
    crew.forEach(function (a, i) {
      var seat = SEATS[i % SEATS.length];
      a.celebrate = false;
      a.seated = false;
      a.facing = seat.face;
      goTo(a, meetingPath(seat), i * 45);
    });
    log('Reunión lanzada: ' + name + '. Todo el equipo va a la sala de juntas.', 'meet');
    charge(2200 + Math.floor(Math.random() * 1400));
  }

  function handleMeeting(now) {
    if (!meeting.active) return;
    if (now < meeting.until) return;
    if (meeting.phase === 'gather') {
      var stillWalking = crew.some(function (a) { return a.path.length > 0; });
      var waited = now - meeting.startedAt;
      if (stillWalking && waited < 20000) {
        meeting.until = now + 650;
        return;
      }
      meeting.phase = 'sit';
      meeting.until = now + 5200;
      els.meetText.textContent = 'REUNIÓN · ' + meeting.project.toUpperCase() + ' · SESIÓN';
    } else if (meeting.phase === 'sit') {
      meeting.phase = 'celebrate';
      meeting.until = now + 3000;
      els.meetText.textContent = 'REUNIÓN · ' + meeting.project.toUpperCase() + ' · CELEBRANDO';
      crew.forEach(function (a) {
        a.seated = false;
        a.celebrate = true;
      });
      if (window.__officeConfetti) window.__officeConfetti();
      log('Celebración del equipo: ' + meeting.project + ' aprobado.', 'meet');
      charge(1500);
    } else if (meeting.phase === 'celebrate') {
      finishMeeting();
    }
  }

  function finishMeeting() {
    var project = meeting.project;
    meeting.active = false;
    meeting.phase = '';
    els.meetChip.classList.remove('show');
    els.endMeetBtn.hidden = true;
    var pending = {};
    deliveries.forEach(function (d) { pending[d.agentId] = true; });
    var now = performance.now();
    crew.forEach(function (a) {
      a.celebrate = false;
      a.seated = false;
      a.facing = 0;
      if (a.boss) {
        goTo(a, deskPath(a), 0);
        return;
      }
      if (pending[a.id]) {
        if (a.state === 'changes') {
          a.startedAt = now;
          a.dueAt = now + 4500 + Math.random() * 4000;
          goTo(a, deskPath(a), 0);
        }
        return;
      }
      a.state = 'working';
      a.task = project + ' · ' + randTask();
      a.round = 0;
      a.startedAt = now;
      a.dueAt = now + 7500 + Math.random() * 10000;
