  // =====================================================================
  // INCIDENTE "PROD IS DOWN"
  // =====================================================================
  var incident = { active: false, startedAt: 0, reason: '', failures: {}, participants: {}, rootCause: null };
  var failureLog = [];
  var INC_KEY = 'la-oficina-incident-v1';
  var lastIncidentAt = null;

  function loadIncident() {
    try {
      var v = JSON.parse(localStorage.getItem(INC_KEY) || 'null');
      if (v && v.at) lastIncidentAt = v.at;
    } catch (e) {}
  }
  function persistIncident() {
    try { localStorage.setItem(INC_KEY, JSON.stringify({ at: lastIncidentAt })); } catch (e) {}
  }
  function setDaysWithout(n) {
    if (n === 0) { lastIncidentAt = Date.now(); persistIncident(); }
  }
  function daysWithout() {
    if (incident.active) return 0;
    if (!lastIncidentAt) return null;
    return Math.floor((Date.now() - lastIncidentAt) / 86400000);
  }
  function fmtDuration(sec) {
    var m = Math.floor(sec / 60);
    var s = sec % 60;
    return m + 'm ' + s + 's';
  }
  function renderIncidentSign() {
    var d = daysWithout();
    var value = incident.active ? 0 : d;
    // Sin dato ("—") la píldora no aporta nada: se oculta sin tocar la lógica de incidente.
    var sinDato = value == null || value === '—';
    els.incidentSign.textContent = 'Días sin incidente: ' + (sinDato ? '—' : value);
    els.incidentSign.style.display = sinDato ? 'none' : '';
    els.incidentSign.classList.toggle('bad', incident.active);
  }
  function renderIncidentTimer() {
    if (!incident.active) return;
    var s = Math.floor((Date.now() - incident.startedAt) / 1000);
    var mm = String(Math.floor(s / 60)).padStart(2, '0');
    var ss = String(s % 60).padStart(2, '0');
    els.incidentTimer.textContent = mm + ':' + ss;
  }
  function initIncident() {
    loadIncident();
    renderIncidentSign();
  }

  function triggerIncident(reason, recentFailures) {
    if (incident.active) return;
    incident.active = true;
    incident.startedAt = Date.now();
    incident.reason = reason || 'incidente';
    incident.failures = {};
    incident.participants = {};
    var list = recentFailures || failureLog;
    list.forEach(function (f) {
      var tk = f.tool || 'desconocido';
      incident.failures[tk] = (incident.failures[tk] || 0) + 1;
      if (f.agent) incident.participants[f.agent] = true;
    });
    incident.rootCause = list.length ? list[list.length - 1] : null;
    setDaysWithout(0);
    incDay('incidents', 1);
    if (window.__officeIncident) window.__officeIncident(true);
    els.incidentBanner.hidden = false;
    els.incidentTint.hidden = false;
    els.clearIncidentBtn.hidden = false;
    els.incidentWhy.textContent = reason;
    renderIncidentSign();
    renderIncidentTimer();
    log('🚨 INCIDENTE · Prod is down: ' + reason, 'changes');
  }

  function clearIncident() {
    if (!incident.active) return;
    var durSec = Math.round((Date.now() - incident.startedAt) / 1000);
    var fails = Object.keys(incident.failures).map(function (k) { return k + '×' + incident.failures[k]; }).join(', ') || 'ninguno';
    var who = Object.keys(incident.participants).join(', ') || '—';
    var cause = incident.rootCause ? (incident.rootCause.agent + '/' + (incident.rootCause.tool || '?')) : 'desconocida';
    log('📝 Postmortem · duró ' + fmtDuration(durSec) + ' · fallos: ' + fails + ' · equipo: ' + who + ' · causa raíz: ' + cause, 'info');
    incident.active = false;
    if (window.__officeIncident) window.__officeIncident(false);
    els.incidentBanner.hidden = true;
    els.incidentTint.hidden = true;
    els.clearIncidentBtn.hidden = true;
    renderIncidentSign();
  }

  function isToday(ms) {
    var d = new Date(ms);
    var n = new Date();
    return d.getFullYear() === n.getFullYear() && d.getMonth() === n.getMonth() && d.getDate() === n.getDate();
  }

  function recordFailure(agent, tool, at) {
    var t = (typeof at === 'number') ? at : Date.now();
    failureLog.push({ t: t, agent: agent ? agent.name : '', tool: tool || '' });
    var cutoff = Date.now() - 10 * 60 * 1000;
    failureLog = failureLog.filter(function (f) { return f.t >= cutoff; });
    if (isToday(t)) incDay('failures', 1);
    if (agent) markAgentActive(agent);
    var recent = failureLog.filter(function (f) { return Date.now() - f.t < 5 * 60 * 1000; });
    if (agent && agent.name === 'deploy' && !incident.active) {
      triggerIncident('deploy fallido · ' + (tool || 'entrega rechazada'), recent);
    } else if (recent.length >= 3 && !incident.active) {
      triggerIncident('3 herramientas fallidas en 5 min', recent);
    }
  }

  function recordDone(agent, task) {
    if (!agent || agent.boss) return;
    boardDone.push({ task: task, agent: agent.name, at: Date.now() });
    if (boardDone.length > 60) boardDone.shift();
    incDay('tasksDone', 1);
    markAgentActive(agent);
  }

