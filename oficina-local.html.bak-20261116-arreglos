  var permCards = {};
  var audioCtx = null;
  var soundOn = true;

  function ensureAudio() {
    if (!audioCtx) {
      try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { audioCtx = null; }
    }
    if (audioCtx && audioCtx.state === 'suspended') { try { audioCtx.resume(); } catch (e) {} }
  }

  function playChime() {
    if (!soundOn) return;
    ensureAudio();
    if (!audioCtx) return;
    try {
      var o = audioCtx.createOscillator();
      var g = audioCtx.createGain();
      o.type = 'sine';
      g.gain.value = 0.08;
      o.connect(g);
      g.connect(audioCtx.destination);
      o.frequency.setValueAtTime(880, audioCtx.currentTime);
      o.frequency.setValueAtTime(1175, audioCtx.currentTime + 0.12);
      o.start();
      o.stop(audioCtx.currentTime + 0.32);
    } catch (e) {}
  }

  function raiseHand(agent) {
    agent.raisedHand = true;
    agent.raisedAt = Date.now();
    drawBubble(agent);
  }

  function lowerHand(agent) {
    if (!agent) return;
    agent.raisedHand = false;
    agent.raisedAt = 0;
    drawBubble(agent);
  }

  function raisePermission(agent, delivery) {
    if (!agent || !delivery) return;
    if (permCards[delivery.id]) return;
    raiseHand(agent);
    playChime();
    var card = document.createElement('div');
    card.className = 'perm-card';
    card.id = 'perm-' + delivery.id;
    var hd = document.createElement('div');
    hd.className = 'perm-head';
    var hh = document.createElement('span');
    hh.className = 'h';
    hh.textContent = '✋';
    var ht = document.createElement('span');
    ht.className = 't';
    ht.textContent = agent.name + ' te necesita';
    hd.appendChild(hh);
    hd.appendChild(ht);
    var bd = document.createElement('div');
    bd.className = 'perm-body';
    bd.textContent = delivery.task;
    var ac = document.createElement('div');
    ac.className = 'perm-actions';
    var allow = document.createElement('button');
