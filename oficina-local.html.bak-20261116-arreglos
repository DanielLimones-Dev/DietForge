    function pickAgent(e) {
      var rect = el.getBoundingClientRect();
      pickPointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      pickPointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(pickPointer, camera);
      var meshes = crew.map(function (a) { return a.mesh; }).filter(Boolean);
      var hits = raycaster.intersectObjects(meshes, true);
      for (var i = 0; i < hits.length; i += 1) {
        var obj = hits[i].object;
        while (obj) {
          if (obj.userData && obj.userData.agentId !== undefined) {
            var a = crew[obj.userData.agentId];
            if (a) openInspector(a);
            return;
          }
          obj = obj.parent;
