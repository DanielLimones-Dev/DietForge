  function setStateVisual(agent) {
    var st = STATUS[agent.state] || STATUS.free;
    if (agent.rowEl) {
      agent.dotEl.style.background = st.color;
      agent.pillEl.className = 'pill ' + agent.state;
      agent.pillEl.textContent = agent.boss ? 'Patrón' : st.label;
      var line = '';
      if (agent.boss) line = 'Conduciendo la oficina';
      else if (agent.state === 'working') line = agent.task || 'Trabajando';
      else if (agent.state === 'review') line = 'Esperando revisión del Patrón';
      else if (agent.state === 'changes') line = 'Rehaciendo: ' + (agent.task || 'cambios');
      else line = 'Disponible · descansando';
      agent.taskEl.textContent = line;
      if (agent.liveEl) {
        agent.liveEl.textContent = agent.live ? 'EN VIVO' : 'demo';
        agent.liveEl.className = 'live-tag' + (agent.live ? ' on' : '');
      }
    }
    if (agent.ring && agent.ring.material) {
      agent.ring.material.color.setHex(st.hex);
    }
    if (agent.screenMat) {
      var glow = agent.state === 'working' ? 0x9fd8ff :
        agent.state === 'changes' ? 0xffb4a8 :
        agent.state === 'review' ? 0xffd28a : 0x37546e;
      agent.screenMat.color.setHex(glow);
