  function requestChanges(id) {
    var d = deliveries.find(function (x) { return x.id === id; });
    if (!d) return;
    var agent = crew[d.agentId];
    d.status = 'changes';
    agent.state = 'changes';
    agent.startedAt = performance.now();
    agent.dueAt = agent.startedAt + 5000 + Math.random() * 4500;
    agent.celebrate = false;
    goTo(agent, deskPath(agent), 0);
    setStateVisual(agent);
    log(agent.name + ' · cambios solicitados (ronda ' + d.round + '). Rehaciendo.', 'changes');
    chatAdd(crew[0], 'Pedí cambios a ' + agent.name + ': ' + d.task, { toName: agent.name });
    charge(320);
    lowerHand(agent);
    closePermission(d.id);
