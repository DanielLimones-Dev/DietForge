  function goTo(agent, points, delayMs) {
    agent.path = points.map(function (p) { return { x: p.x, z: p.z }; });
    agent.moveDelayUntil = performance.now() + (delayMs || 0);
    agent.seated = false;
  }

  function exitRoomPrefix(agent) {
    if (agent.pos.z < -3.6 && agent.pos.x > -21.5 && agent.pos.x < -8.5) {
      return [
        { x: -15.5, z: agent.pos.z },
        { x: -15.5, z: -2.8 }
      ];
    }
    return [];
  }

  function deskPath(agent) {
    return exitRoomPrefix(agent).concat([
      { x: agent.pos.x, z: 7.7 },
      { x: agent.home.x, z: 7.7 },
      { x: agent.home.x, z: agent.home.z }
    ]);
  }

  function queuePath(slot) {
    return [
      { x: slot.x, z: 7.7 },
      { x: slot.x, z: slot.z }
    ];
  }

  function loungePath(agent, spot) {
    return exitRoomPrefix(agent).concat([
      { x: agent.pos.x, z: 7.7 },
      { x: spot.x, z: 7.7 },
      { x: spot.x, z: -2.4 },
      { x: spot.x, z: spot.z }
    ]);
  }

  function meetingPath(seat) {
    return [
      { x: -15.5, z: 8.0 },
      { x: -15.5, z: -3.0 },
      { x: -15.5, z: -4.4 },
      { x: -10.25, z: -4.4 },
      { x: -10.25, z: seat.z < -9 ? -11.9 : -5.1 },
      { x: seat.x, z: seat.z }
    ];
  }

  var loungeCursor = 0;
  function nextLounge() {
    var spot = LOUNGE[loungeCursor % LOUNGE.length];
    loungeCursor += 1;
    return spot;
  }

  function placeAt(agent, p) {
    agent.pos.x = p.x;
    agent.pos.z = p.z;
    if (agent.mesh) {
      agent.mesh.position.x = p.x;
      agent.mesh.position.z = p.z;
    }
  }

  function requeue() {
    var list = crew.filter(function (a) { return !a.boss && a.state === 'review'; })
      .sort(function (a, b) { return (a.deliveryAt || 0) - (b.deliveryAt || 0); });
    list.forEach(function (a, i) {
      var slot = QUEUE[Math.min(i, QUEUE.length - 1)];
      a.queueSlot = slot;
      if (a.mesh) {
        goTo(a, exitRoomPrefix(a).concat(queuePath(slot)), 0);
      }
      a.facing = 0;
    });
  }

  function assignTask(agent, text) {
    if (!agent || agent.boss) return;
    var hadDelivery = deliveries.some(function (d) { return d.agentId === agent.id; });
    if (hadDelivery) {
      deliveries = deliveries.filter(function (d) { return d.agentId !== agent.id; });
    }
    var bi = boardBacklog.indexOf(text);
    if (bi >= 0) boardBacklog.splice(bi, 1);
    lowerHand(agent);
    closePermissionFor(agent.id);
    agent.task = text;
    agent.round = 1;
    agent.deliveryId = null;
    agent.state = 'working';
    agent.startedAt = performance.now();
    agent.dueAt = agent.startedAt + 7500 + Math.random() * 9500;
    agent.celebrate = false;
    agent.seated = false;
    goTo(agent, deskPath(agent), 0);
    setStateVisual(agent);
    log(agent.name + ' recibe: ' + text, 'info');
    charge(700 + Math.floor(Math.random() * 900));
    if (hadDelivery) {
      requeue();
      renderDeliveries();
    }
    renderTasks();
  }

  function createDelivery(agent) {
    deliverySeq += 1;
    var d = {
      id: deliverySeq, agentId: agent.id, task: agent.task,
      round: 1, at: Date.now(), status: 'review'
    };
    deliveries.push(d);
    agent.deliveryId = d.id;
    agent.deliveryAt = d.at;
    return d;
  }

  function completeWork(agent) {
    var d = createDelivery(agent);
