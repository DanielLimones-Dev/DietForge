  function closePermission(deliveryId) {
    var pc = permCards[deliveryId];
    if (!pc) return;
    if (pc.el && pc.el.parentNode) pc.el.parentNode.removeChild(pc.el);
    delete permCards[deliveryId];
  }

  function closePermissionFor(agentId) {
    Object.keys(permCards).forEach(function (k) {
      if (permCards[k].agent.id === agentId) closePermission(Number(k));
    });
  }

  function clearAllPermissions() {
    Object.keys(permCards).forEach(function (k) { closePermission(Number(k)); });
    crew.forEach(function (a) { lowerHand(a); });
  }

  function checkHandTimeout() {
    var now = Date.now();
    Object.keys(permCards).forEach(function (k) {
      var pc = permCards[k];
      if (now - pc.raisedAt > 10 * 60 * 1000) {
        lowerHand(pc.agent);
        closePermission(Number(k));
        log(pc.agent.name + ' bajó la mano (10 min sin respuesta).', 'info');
      }
    });
  }

  function simulatePermission() {
