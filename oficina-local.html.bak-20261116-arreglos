    log(agent.name + ' · reentrega ronda ' + d.round + ': ' + agent.task, 'review');
    chatAdd(agent, 'Reentregué (ronda ' + d.round + '): ' + agent.task, { toName: 'Daniel Patrón' });
    charge(1100);
    renderDeliveries();
    renderTasks();
    raisePermission(agent, d);
