  function drawBubble(agent) {
    if (!agent.bubble) return;
    var c = agent.bubble.canvas;
    var g = agent.bubble.ctx;
    var st = STATUS[agent.state] || STATUS.free;
    g.clearRect(0, 0, c.width, c.height);
    var r = 34, x = 10, y = 10, w = c.width - 20, h = c.height - 20;
    g.beginPath();
    g.moveTo(x + r, y);
    g.lineTo(x + w - r, y);
    g.quadraticCurveTo(x + w, y, x + w, y + r);
    g.lineTo(x + w, y + h - r);
    g.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    g.lineTo(x + r, y + h);
    g.quadraticCurveTo(x, y + h, x, y + h - r);
    g.lineTo(x, y + r);
    g.quadraticCurveTo(x, y, x + r, y);
    g.closePath();
    g.fillStyle = 'rgba(255,255,255,.97)';
    g.fill();
    g.lineWidth = 6;
    // El borde de la burbuja usa el color del estado: se distingue a simple vista.
    g.strokeStyle = st.color;
    g.stroke();
    var dotR = 34;
    g.beginPath();
    g.arc(54, c.height / 2, dotR, 0, Math.PI * 2);
    g.fillStyle = st.color;
    g.fill();
    g.lineWidth = 6;
    g.strokeStyle = 'rgba(255,255,255,.95)';
    g.stroke();
    var name = agent.raisedHand ? '✋ Te necesita' : agent.name;
    var size = agent.raisedHand ? 52 : 58;
    function setFont() { g.font = '800 ' + size + 'px ui-sans-serif, system-ui, -apple-system, sans-serif'; }
    setFont();
    var maxW = c.width - 96;
    while (g.measureText(name).width > maxW && size > 30) {
      size -= 3;
      setFont();
    }
    g.fillStyle = agent.raisedHand ? '#b91c1c' : '#0f172a';
    g.textBaseline = 'middle';
    g.textAlign = 'left';
    var cy = (agent.role && !agent.raisedHand) ? c.height / 2 - 16 : c.height / 2;
    g.fillText(name, 96, cy + 2);
    if (agent.role && !agent.raisedHand) {
      g.fillStyle = '#475569';
      g.font = '700 27px ui-monospace, Menlo, Consolas, monospace';
      g.fillText(agent.role, 96, cy + 40);
    }
    var typing = !agent.raisedHand && (agent.realIntent === 'working' || agent.realIntent === 'changes');
    if (typing) {
      g.fillStyle = '#38bdf8';
      g.font = '800 26px ui-monospace, Menlo, Consolas, monospace';
      g.fillText('tecleando…', 96, c.height - 26);
    } else if (agent.live && !agent.raisedHand) {
      g.fillStyle = '#34d399';
      g.font = '800 26px ui-monospace, Menlo, Consolas, monospace';
      g.fillText('● EN VIVO', 96, c.height - 26);
    }
    agent.bubble.tex.needsUpdate = true;
  }

