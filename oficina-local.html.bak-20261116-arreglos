    function updateCamera() {
      var aspect = W / H;
      var v = 38;
      if (aspect < 1.55) v = Math.min(68, 38 * Math.pow(1.55 / aspect, 0.85));
      camera.left = -v * aspect / 2;
      camera.right = v * aspect / 2;
      camera.top = v / 2;
      camera.bottom = -v / 2;
      camera.zoom = camState.zoom;
      camera.updateProjectionMatrix();
    }

    function placeCamera() {
      var p = camState.polar;
      var a = camState.az;
      camera.position.set(
        camState.target.x + camState.radius * Math.sin(p) * Math.sin(a),
        camState.target.y + camState.radius * Math.cos(p),
        camState.target.z + camState.radius * Math.sin(p) * Math.cos(a)
      );
      camera.lookAt(camState.target);
    }
