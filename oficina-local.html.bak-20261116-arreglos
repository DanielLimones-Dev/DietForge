  function delegateWork(sender, receiver, text) {
    if (!sender || !receiver || !text) return;
    log('→ @' + receiver.name + ': ' + text, 'dm');
    chatAdd(sender, text, { toName: receiver.name });
    if (!sender.mesh) return;
    var tx = receiver.desk.x;
