  function persistState() {
    var snap = buildSnapshot();
    try { localStorage.setItem(STORE_KEY, JSON.stringify(snap)); } catch (e) { /* cuota llena */ }
    if (window.indexedDB) {
      try {
        var req = indexedDB.open(IDB_NAME, 1);
        req.onupgradeneeded = function () {
          if (!req.result.objectStoreNames.contains(IDB_STORE)) req.result.createObjectStore(IDB_STORE);
        };
        req.onsuccess = function () {
          var db = req.result;
          try {
            var tx = db.transaction(IDB_STORE, 'readwrite');
            tx.objectStore(IDB_STORE).put(snap, 'snapshot');
            tx.oncomplete = function () { db.close(); };
          } catch (e) { db.close(); }
        };
      } catch (e) { /* IDB no disponible */ }
    }
  }

  function applySnapshot(data) {
    if (!data) return;
    clearAllPermissions();
    if (typeof data.tokensUsed === 'number') tokensUsed = data.tokensUsed;
    if (typeof data.tokensBudget === 'number') tokensBudget = data.tokensBudget;
    if (Array.isArray(data.log) && data.log.length) {
      logEntries = data.log.filter(function (e) { return e && e.text; });
      renderLog();
    }
    if (Array.isArray(data.deliveries)) {
      deliveries = data.deliveries.filter(function (d) { return d && d.agentId !== undefined; });
      deliverySeq = deliveries.reduce(function (m, d) { return Math.max(m, d.id || 0); }, 0);
    }
    if (Array.isArray(data.agents)) {
      data.agents.forEach(function (s) {
        var a = crew.find(function (x) { return x.id === s.id; });
        if (!a || a.boss) return;
        var st = STATUS[s.state] ? s.state : 'free';
        a.state = st;
        a.task = s.task || '';
        a.round = s.round || 0;
        if (st === 'review') {
          var d = deliveries.find(function (x) { return x.agentId === a.id; });
          if (d) { a.deliveryId = d.id; a.deliveryAt = d.at || Date.now(); }
        }
        if (st === 'working' || st === 'changes') {
          a.startedAt = performance.now();
          a.dueAt = a.startedAt + 8000 + Math.random() * 6000;
          a.celebrate = false;
        }
      });
      var reviewIdx = 0;
      crew.forEach(function (a) {
        if (a.boss) { placeAt(a, a.home); return; }
        if (a.state === 'review') {
          var slot = QUEUE[reviewIdx] || QUEUE[0];
          reviewIdx += 1;
          a.queueSlot = slot; a.facing = 0;
          placeAt(a, slot);
        } else if (a.state === 'free') {
          placeAt(a, nextLounge());
        } else {
          placeAt(a, a.home);
        }
        setStateVisual(a);
      });
    }
    updateSummary();
    renderDeliveries();
    renderTasks();
    updateTokens();
  }

  function loadState() {
    var data = null;
    try { data = JSON.parse(localStorage.getItem(STORE_KEY) || 'null'); } catch (e) { data = null; }
    if (data) { applySnapshot(data); return; }
    if (!window.indexedDB) return;
    try {
      var req = indexedDB.open(IDB_NAME, 1);
      req.onupgradeneeded = function () {
        if (!req.result.objectStoreNames.contains(IDB_STORE)) req.result.createObjectStore(IDB_STORE);
      };
      req.onsuccess = function () {
        var db = req.result;
        if (!db.objectStoreNames.contains(IDB_STORE)) { db.close(); return; }
        try {
          var tx = db.transaction(IDB_STORE, 'readonly');
          var g = tx.objectStore(IDB_STORE).get('snapshot');
          g.onsuccess = function () { db.close(); if (g.result) applySnapshot(g.result); };
          g.onerror = function () { db.close(); };
        } catch (e) { db.close(); }
      };
    } catch (e) { /* IDB no disponible */ }
  }

