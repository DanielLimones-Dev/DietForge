    goTo(sender, [
      { x: sender.pos.x, z: 7.7 },
      { x: tx, z: 7.7 },
      { x: tx, z: tz, pause: 900, face: Math.PI, onArrive: function () {
          if (receiver && !receiver.boss && receiver.state === 'free' && !receiver.task) {
            assignTask(receiver, text);
          }
        } },
      { x: tx, z: 7.7 },
      { x: sender.home.x, z: 7.7 },
      { x: sender.home.x, z: sender.home.z }
    ], 0);
  }

  // =====================================================================
  // CHAT DE LA OFICINA (dedicado, separado de la bitácora)
  // =====================================================================
  var CHAT_KEY = 'la-oficina-chat-v1';
  var chatMessages = [];
  var chatSeq = 0;
  var chatFilterAgent = '';
  var chatFilterProject = '';
  var chatSearchText = '';
  var demoChatIdx = 0;
  var lastChatIdByAgent = {};

  var chatEls = {
    panel: $('chatPanel'), body: $('chatBody'), count: $('chatCount'),
    btn: $('chatBtn'), closeBtn: $('chatCloseBtn'), clearBtn: $('chatClearBtn'),
    agentFilter: $('chatAgentFilter'), projectFilter: $('chatProjectFilter'), search: $('chatSearch')
  };

  function agentColor(a) {
    var hex = (a && typeof a.suit === 'number') ? a.suit : 0x64748b;
    return '#' + ('000000' + hex.toString(16)).slice(-6);
  }

  function chatProjectOf(text) {
    var t = (text || '').toLowerCase();
    if (t.indexOf('repforge') >= 0) return 'RepForge';
    if (t.indexOf('dietforge') >= 0) return 'DietForge';
    if (t.indexOf('suplemento') >= 0) return 'Suplementos';
    return '';
  }

  function chatAdd(agent, text, opts) {
    if (!agent || !text) return;
    opts = opts || {};
    chatSeq += 1;
    var msg = {
      id: chatSeq,
      at: Date.now(),
      agentId: agent.id,
      agentName: agent.name,
      color: agentColor(agent),
      text: text,
      replyToId: opts.replyToId || null,
      toName: opts.toName || '',
      project: opts.project || chatProjectOf(text) || meeting.project || ''
    };
    chatMessages.push(msg);
    if (chatMessages.length > 400) chatMessages.splice(0, chatMessages.length - 400);
    lastChatIdByAgent[agent.name] = msg.id;
    chatPersist();
    chatRender();
  }

  function chatPersist() {
    var data = { messages: chatMessages.slice(0, 400), seq: chatSeq };
    try { localStorage.setItem(CHAT_KEY, JSON.stringify(data)); } catch (e) { /* cuota llena */ }
    if (window.indexedDB) {
      try {
        var req = indexedDB.open(IDB_NAME, 1);
        req.onupgradeneeded = function () {
          if (!req.result.objectStoreNames.contains(IDB_STORE)) req.result.createObjectStore(IDB_STORE);
        };
        req.onsuccess = function () {
          var db = req.result;
          try {
            var tx = db.transaction(IDB_STORE, 'readwrite');
            tx.objectStore(IDB_STORE).put(data, 'chat');
            tx.oncomplete = function () { db.close(); };
          } catch (e) { db.close(); }
        };
      } catch (e) { /* IDB no disponible */ }
    }
  }

  function chatApply(data) {
    if (!data || !Array.isArray(data.messages)) return;
    chatMessages = data.messages.slice(0, 400).filter(function (m) { return m && m.text; });
    chatSeq = data.seq || chatMessages.length;
    chatMessages.forEach(function (m) { if (m.agentName) lastChatIdByAgent[m.agentName] = m.id; });
    chatRender();
  }

  function chatLoad() {
    var data = null;
    try { data = JSON.parse(localStorage.getItem(CHAT_KEY) || 'null'); } catch (e) { data = null; }
    if (data) { chatApply(data); return; }
    if (!window.indexedDB) return;
    try {
      var req = indexedDB.open(IDB_NAME, 1);
      req.onupgradeneeded = function () {
        if (!req.result.objectStoreNames.contains(IDB_STORE)) req.result.createObjectStore(IDB_STORE);
      };
      req.onsuccess = function () {
        var db = req.result;
        if (!db.objectStoreNames.contains(IDB_STORE)) { db.close(); return; }
        try {
          var tx = db.transaction(IDB_STORE, 'readonly');
          var g = tx.objectStore(IDB_STORE).get('chat');
          g.onsuccess = function () { db.close(); if (g.result) chatApply(g.result); };
          g.onerror = function () { db.close(); };
        } catch (e) { db.close(); }
      };
    } catch (e) { /* IDB no disponible */ }
  }

  function chatVisibleMessages() {
    var q = (chatSearchText || '').toLowerCase();
    return chatMessages.filter(function (m) {
      if (chatFilterAgent && m.agentName !== chatFilterAgent) return false;
      if (chatFilterProject && m.project !== chatFilterProject) return false;
      if (q && m.text.toLowerCase().indexOf(q) < 0) return false;
      return true;
    });
  }

  function chatMsgEl(m, byId) {
    var wrap = document.createElement('div');
    wrap.className = 'chat-msg';
    var av = document.createElement('div');
    av.className = 'chat-avatar';
    av.style.background = m.color;
    av.textContent = (m.agentName || '?').charAt(0).toUpperCase();
    var main = document.createElement('div');
    main.className = 'chat-main';
    var head = document.createElement('div');
    head.className = 'chat-msg-head';
    var nm = document.createElement('span');
    nm.className = 'chat-name';
    nm.textContent = m.agentName;
    var tm = document.createElement('span');
    tm.className = 'chat-time';
    tm.textContent = new Date(m.at).toLocaleTimeString('es-ES', { hour12: false });
    head.appendChild(nm);
    head.appendChild(tm);
    main.appendChild(head);
    if (m.replyToId && byId[m.replyToId]) {
      var rp = document.createElement('div');
      rp.className = 'chat-reply';
      rp.innerHTML = 'en respuesta a <b>' + byId[m.replyToId].agentName + '</b>';
      main.appendChild(rp);
    }
    if (m.toName) {
      var to = document.createElement('div');
      to.className = 'chat-to';
      to.textContent = '→ para @' + m.toName;
      main.appendChild(to);
    }
    var txt = document.createElement('div');
    txt.className = 'chat-text';
    txt.textContent = m.text;
    main.appendChild(txt);
    wrap.appendChild(av);
    wrap.appendChild(main);
    return wrap;
  }

  function chatRender() {
    var list = chatVisibleMessages();
    var body = chatEls.body;
    body.innerHTML = '';
    chatEls.count.textContent = String(chatMessages.length);
    if (!list.length) {
      var empty = document.createElement('div');
      empty.className = 'chat-empty';
      empty.textContent = chatMessages.length ? 'Sin mensajes con estos filtros.' : 'Aún no hay mensajes en el Chat de la Oficina.';
      body.appendChild(empty);
      return;
    }
    var byId = {};
    chatMessages.forEach(function (m) { byId[m.id] = m; });
    list.forEach(function (m) { body.appendChild(chatMsgEl(m, byId)); });
    body.scrollTop = body.scrollHeight;
  }

  function chatClear() {
    if (!chatMessages.length) { log('El Chat de la Oficina ya está vacío.', 'info'); return; }
    if (!window.confirm('¿Vaciar el Chat de la Oficina? Se borrarán ' + chatMessages.length + ' mensajes.')) return;
    chatMessages = [];
    chatSeq = 0;
    lastChatIdByAgent = {};
    chatPersist();
    chatRender();
    log('Chat de la Oficina vaciado.', 'info');
  }

  function chatToggle(force) {
    // El chat lateral es siempre visible; este toggle ahora colapsa/expande
    // el lateral y deja que la escena 3D recupere su ancho (dispara resize).
    var collapsed = force !== undefined ? !force : !document.body.classList.contains('chat-collapsed');
    document.body.classList.toggle('chat-collapsed', collapsed);
    chatEls.btn.classList.toggle('on', !collapsed);
    chatEls.btn.setAttribute('aria-pressed', collapsed ? 'false' : 'true');
    if (!collapsed) chatRender();
    window.dispatchEvent(new Event('resize'));
  }

  var DEMO_CHAT_SCRIPT = [
    { agent: 'Mini lemons', text: 'Propongo lanzar RepForge esta semana. ¿Opiniones?' },
    { agent: 'Claude', text: 'A favor. El core ya pasó typecheck y lint en verde.', replyTo: 'Mini lemons' },
    { agent: 'DeepSeek', text: 'En contra por ahora: faltan tests de regresión en el flujo de pagos.', replyTo: 'Mini lemons' },
    { agent: 'GPT', text: 'Coincido con DeepSeek. Sin tests de Stripe no deberíamos exponer cobros.', replyTo: 'DeepSeek' },
    { agent: 'Gemini', text: 'Yo puedo dejar lista la checklist de deploy y el rollback automático hoy mismo.', replyTo: 'Mini lemons' },
    { agent: 'debate', text: 'Hay dos posturas: lanzar ya vs. esperar a los tests. Propongo votar.', replyTo: 'GPT' },
    { agent: 'review', text: 'Revisé el PR de RepForge: 3 issues menores, ninguno bloqueante.', replyTo: 'debate' },
    { agent: 'deploy', text: 'El pipeline está verde, pero no toco producción sin el OK del Patrón.', replyTo: 'review' },
    { agent: 'test', text: 'Dame 2 horas y cierro la cobertura crítica. Luego voto por lanzar.', replyTo: 'DeepSeek' },
    { agent: 'Daniel Patrón', text: 'Calma, equipo. Lanzamos solo si test y review dan luz verde en 2 horas.', replyTo: 'deploy' },
    { agent: 'Mini lemons', text: 'Entendido, Patrón. Pongo a test y review al frente.', replyTo: 'Daniel Patrón' },
    { agent: 'test', text: 'Cobertura al 84%. Listo para lanzar.', replyTo: 'Mini lemons' },
    { agent: 'review', text: 'Aprobado por mi parte. Sin bloqueantes.', replyTo: 'test' },
    { agent: 'deploy', text: 'Producción en verde. RepForge vivo.', replyTo: 'review' },
    { agent: 'GPT', text: 'Buen lanzamiento. Redacto el postmortem.', replyTo: 'deploy' },
    { agent: 'Daniel Patrón', text: 'Bien hecho. Cerramos la ronda de RepForge.', replyTo: 'deploy' }
  ];

  function chatDemoStep() {
    if (!DEMO_CHAT_SCRIPT.length) return;
    var step = DEMO_CHAT_SCRIPT[demoChatIdx % DEMO_CHAT_SCRIPT.length];
    demoChatIdx += 1;
    if (demoChatIdx >= DEMO_CHAT_SCRIPT.length) demoChatIdx = 0;
    var agent = findAgent(step.agent);
    if (!agent) return;
    if (agent.hasRealSession) return;
    var replyToId = step.replyTo ? (lastChatIdByAgent[step.replyTo] || null) : null;
    chatAdd(agent, step.text, { replyToId: replyToId, project: 'RepForge' });
  }

  (function buildChatAgentFilter() {
    var sel = chatEls.agentFilter;
    var opt = document.createElement('option');
    opt.value = '';
    opt.textContent = 'Todos los agentes';
    sel.appendChild(opt);
    crew.forEach(function (a) {
      var o = document.createElement('option');
      o.value = a.name;
      o.textContent = a.name;
      sel.appendChild(o);
    });
  })();

  chatEls.btn.addEventListener('click', function () { chatToggle(); });
  chatEls.closeBtn.addEventListener('click', function () { chatToggle(false); });
  chatEls.clearBtn.addEventListener('click', chatClear);
  chatEls.agentFilter.addEventListener('change', function () { chatFilterAgent = chatEls.agentFilter.value; chatRender(); });
  chatEls.projectFilter.addEventListener('change', function () { chatFilterProject = chatEls.projectFilter.value; chatRender(); });
  chatEls.search.addEventListener('input', function () { chatSearchText = chatEls.search.value; chatRender(); });

  setInterval(function () {
    if (!demoOn || meeting.active) return;
    chatDemoStep();
  }, 4200);

  chatLoad();
  chatRender();
  chatEls.btn.classList.add('on');
  chatEls.btn.setAttribute('aria-pressed', 'true');

  // =====================================================================
  // WIRING DE BOTONES
  // =====================================================================
  els.simPermBtn.addEventListener('click', simulatePermission);
  els.clearIncidentBtn.addEventListener('click', clearIncident);
  els.clearIncidentBtn2.addEventListener('click', clearIncident);
  els.muteBtn.addEventListener('click', toggleSound);
  els.muteBtn2.addEventListener('click', toggleSound);
  els.recapBtn.addEventListener('click', recapLine);

  document.addEventListener('pointerdown', function onceAudio() {
    ensureAudio();
    document.removeEventListener('pointerdown', onceAudio);
  });

  seed();
  loadState();
  setInterval(persistState, 3000);
  window.addEventListener('beforeunload', persistState);
  setInterval(function () {
    var now = performance.now();
    crew.forEach(function (a) {
      if (!a.boss && a.state === 'free' && a.mesh && !a.path.length && !meeting.active && !a.hasRealSession && Math.random() < 0.006) {
        goTo(a, loungePath(a, nextLounge()), 0);
      }
    });
  }, 4000);

  probeHealth();
  setInterval(probeHealth, 5000);

  loadDay();
  renderRecap();
  initIncident();
  renderMeters();
  refreshOpenCode();
  setInterval(refreshOpenCode, 5000);
  setInterval(checkHandTimeout, 30000);
  setInterval(renderIncidentTimer, 1000);

  // Referencia usada por las rutas de la sala de juntas.
  function agentSeatInfo(a) {
    return SEATS[a.index % SEATS.length];
  }
  void agentSeatInfo;

  // =====================================================================
  // BLOQUE NUEVO · REDISEÑO SALA DE CONTROL (2026-11-16)
  // Navegación por pestañas + vistas con body[data-view]. Teclas 1-6 y hash.
  // Solo orquesta el DOM; no modifica la lógica existente (chat, entrega,
  // pizarrón, bitácora, recap, consola, Three.js ni polling).
  // =====================================================================
  var VIEW_ORDER = ['oficina', 'chat', 'pizarron', 'entregas', 'bitacora', 'medidores'];
  var VIEW_HASH = { oficina: '#oficina', chat: '#chat', pizarron: '#pizarron', entregas: '#entregas', bitacora: '#bitacora', medidores: '#medidores' };
  var HASH_VIEW = { '#oficina': 'oficina', '#chat': 'chat', '#pizarron': 'pizarron', '#entregas': 'entregas', '#bitacora': 'bitacora', '#medidores': 'medidores' };
  var tabButtons = (function () {
    var nav = document.getElementById('officeTabs');
    return nav ? Array.prototype.slice.call(nav.querySelectorAll('.tab')) : [];
  })();
  var currentView = 'oficina';

  function setActiveTab(view) {
    tabButtons.forEach(function (btn) {
      var active = btn.getAttribute('data-view') === view;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
  }

  function focusChat() {
    document.body.classList.remove('chat-collapsed');
    chatEls.btn.classList.add('on');
    chatEls.btn.setAttribute('aria-pressed', 'true');
    var panel = chatEls.panel;
    if (!panel) return;
    if (panel.scrollIntoView) panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    if (!panel.hasAttribute('tabindex')) panel.setAttribute('tabindex', '-1');
    try { panel.focus({ preventScroll: true }); } catch (e) { panel.focus(); }
  }

  function setView(view, opts) {
    if (VIEW_ORDER.indexOf(view) < 0) view = 'oficina';
    opts = opts || {};
    var prev = currentView;
    currentView = view;
    document.body.setAttribute('data-view', view);
    setActiveTab(view);
    // Chat es un panel lateral siempre visible: la pestaña solo lo enfoca.
    if (view === 'chat') {
      focusChat();
    }
    // Cualquier cambio de vista reencuadra el canvas 3D (por el layout lateral).
    window.dispatchEvent(new Event('resize'));
    // Persistir en el hash sin añadir entradas al historial.
    var hash = VIEW_HASH[view];
    if (!opts.silent && hash) {
      try {
        if (window.history && window.history.replaceState) history.replaceState(null, '', hash);
        else window.location.hash = hash;
      } catch (e) { /* hash no disponible */ }
    }
  }

  tabButtons.forEach(function (btn) {
    btn.addEventListener('click', function () { setView(btn.getAttribute('data-view')); });
  });

  document.addEventListener('keydown', function (e) {
    if (e.defaultPrevented) return;
    var tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
    if (tag === 'input' || tag === 'textarea' || tag === 'select' || (e.target && e.target.isContentEditable)) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    var n = parseInt(e.key, 10);
    if (n >= 1 && n <= 6) setView(VIEW_ORDER[n - 1]);
  });

  // Al cerrar el chat desde su botón, volver a Oficina.
  if (chatEls.closeBtn) {
    chatEls.closeBtn.addEventListener('click', function () {
      if (currentView === 'chat') setView('oficina');
    });
  }

  // Contador "N agentes" en el menú.
  (function () {
    var c = document.getElementById('liveAgentCount');
    if (c) c.textContent = String(crew.length);
  })();

  // Estado inicial desde el hash (default: oficina).
  setView(HASH_VIEW[location.hash] || 'oficina', { silent: true });
})();
</script>
<script>
(function () {
  'use strict';

  /* ---- Buscador global (⌘K / Ctrl+K) ---- */
  var g = document.getElementById('globalSearchInput');
  var chatSearch = document.getElementById('chatSearch');
  var searchTimer = null;

  function filterNodes(q) {
    ['.agent-row', '.delivery', '.log-item', '.board-card'].forEach(function (sel) {
      var nodes = document.querySelectorAll(sel);
      for (var i = 0; i < nodes.length; i += 1) {
        var el = nodes[i];
        var t = (el.textContent || '').toLowerCase();
        var match = !q || t.indexOf(q) >= 0;
        if (el.hidden !== !match) el.hidden = !match;
      }
    });
  }

  function filterPanels(q) {
    q = (q || '').trim().toLowerCase();
    if (q) {
      if (!searchTimer) searchTimer = setInterval(function () { filterNodes(q); }, 400);
    } else if (searchTimer) {
      clearInterval(searchTimer);
      searchTimer = null;
    }
    filterNodes(q);
  }

  function applyGlobal(q) {
    // 1) sincroniza con el buscador del chat (reutiliza su lógica de filtrado)
    if (chatSearch) {
      chatSearch.value = q;
      try { chatSearch.dispatchEvent(new Event('input', { bubbles: true })); } catch (e) {}
    }
    // 2) filtro ligero de paneles por texto
    filterPanels(q);
  }

  if (g) {
    g.addEventListener('input', function () { applyGlobal(g.value); });
    g.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { g.value = ''; applyGlobal(''); g.blur(); }
    });
  }

  document.addEventListener('keydown', function (e) {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      if (g) { g.focus(); if (g.select) g.select(); }
    }
  });

  /* ---- Badges del menú desde los contadores existentes (ocultos si 0) ---- */
  var BADGE_MAP = [
    { src: 'chatCount', dst: 'tabChatBadge' },
    { src: 'deliveryCount', dst: 'tabDeliveryBadge' },
    { src: 'taskCount', dst: 'tabTaskBadge' }
  ];

  function syncBadges() {
    BADGE_MAP.forEach(function (m) {
      var s = document.getElementById(m.src);
      var d = document.getElementById(m.dst);
      if (!s || !d) return;
      var n = parseInt(s.textContent, 10) || 0;
      d.textContent = String(n);
      d.hidden = n === 0;
    });
  }

  if (window.MutationObserver) {
    BADGE_MAP.forEach(function (m) {
      var s = document.getElementById(m.src);
      if (s) new MutationObserver(syncBadges).observe(s, { childList: true, characterData: true, subtree: true });
    });
  }
  syncBadges();
})();
</script>
