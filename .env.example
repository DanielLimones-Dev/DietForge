FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
USDA_API_KEY=DEMO_KEY
# Opcional: proxy existente; si está vacío se usan las credenciales de arriba.
FATSECRET_WORKER=

# Supabase (anon key — segura para frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Dominio público de DietForge, sin diagonal final. En local puede omitirse.
NEXT_PUBLIC_SITE_URL=https://dietforge.example.com

# GitHub Actions usa los mismos valores como secretos con estos nombres.
# No se necesita ni se debe usar la service role para la comprobación de salud.
SUPABASE_HEALTH_URL=https://your-project.supabase.co
SUPABASE_HEALTH_ANON_KEY=your_anon_key_here

# Stripe Payment Link (para redirigir al checkout)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_ANNUAL=

# Los secretos de FatSecret/USDA se leen SOLO en el servidor de Next.js.
# Nunca añadir NEXT_PUBLIC_ a secretos ni usar una service_role key en el cliente.

# Solo servidor: altas e invitaciones de coaches por el administrador.
SUPABASE_SERVICE_ROLE_KEY=
